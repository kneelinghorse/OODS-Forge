{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol.aquex.ai/contracts/api/trace-response.schema.json",
  "$comment": "Single-sourced from concordance scope §7.6 + plan §6 + decision #246. POST /trace response body. Each path is a node sequence + edge sequence + total_weight (sum of per-edge weights, default 1.0 when relationships.weight is NULL) + path_length (hop count). `pruned=true` when traversal hit either the max_depth or max_paths bound; `pruned=false` when traversal completed without truncation.",
  "title": "TraceResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["paths", "pruned", "traversal_stats"],
  "properties": {
    "paths": {
      "type": "array",
      "items": {"$ref": "#/$defs/Path"},
      "description": "Ordered list of paths from from_urn outward. A* mode: 0 or 1 entries. BFS mode: 0..max_paths entries, ordered by (path_length asc, total_weight asc, terminal_urn asc) for stable client iteration."
    },
    "pruned": {
      "type": "boolean",
      "description": "True when traversal was truncated by max_depth or max_paths. Distinguishes 'no path found within bounds' from 'no path exists' on caller introspection."
    },
    "traversal_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes_visited", "edges_traversed", "time_ms"],
      "properties": {
        "nodes_visited": {"type": "integer", "minimum": 0},
        "edges_traversed": {"type": "integer", "minimum": 0},
        "time_ms": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "Path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "total_weight", "path_length"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["urn", "name", "kind"],
            "properties": {
              "urn": {"type": "string", "minLength": 1},
              "name": {"type": "string"},
              "kind": {"type": "string"}
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "weight", "direction"],
            "properties": {
              "type": {"type": "string", "minLength": 1},
              "weight": {"type": "number", "minimum": 0},
              "direction": {"type": "string", "enum": ["out", "in"]}
            }
          }
        },
        "total_weight": {"type": "number", "minimum": 0},
        "path_length": {"type": "integer", "minimum": 0}
      }
    }
  }
}
