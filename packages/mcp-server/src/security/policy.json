{
  "artifactsBase": "artifacts/current-state",
  "roles": [
    "designer",
    "maintainer"
  ],
  "rules": [
    {
      "tool": "tokens.build",
      "allow": [
        "designer",
        "maintainer"
      ],
      "writes": [
        "${BASE}/${DATE}/**"
      ],
      "timeoutMs": 60000,
      "ratePerMinute": 30,
      "concurrency": 1
    },
    {
      "tool": "brand.apply",
      "allow": [
        "designer",
        "maintainer"
      ],
      "writes": [
        "${BASE}/${DATE}/**"
      ],
      "timeoutMs": 120000,
      "ratePerMinute": 12,
      "concurrency": 1
    },
    {
      "tool": "diag.snapshot",
      "allow": [
        "designer",
        "maintainer"
      ],
      "writes": [
        "${BASE}/${DATE}/**"
      ],
      "timeoutMs": 120000,
      "ratePerMinute": 12,
      "concurrency": 1
    },
    {
      "tool": "catalog.list",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "structuredData.fetch",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "release.verify",
      "allow": [
        "maintainer"
      ],
      "writes": [
        "${BASE}/${DATE}/**"
      ],
      "timeoutMs": 180000,
      "ratePerMinute": 6,
      "concurrency": 1
    },
    {
      "tool": "release.tag",
      "allow": [
        "maintainer"
      ],
      "writes": [
        "${BASE}/${DATE}/**"
      ],
      "timeoutMs": 60000,
      "ratePerMinute": 6,
      "concurrency": 1
    },
    {
      "tool": "a11y.scan",
      "allow": [
        "designer",
        "maintainer"
      ],
      "writes": [
        "${BASE}/${DATE}/**"
      ],
      "timeoutMs": 120000,
      "ratePerMinute": 12,
      "concurrency": 1
    },
    {
      "tool": "billing.reviewKit",
      "allow": [
        "designer",
        "maintainer"
      ],
      "writes": [
        "${BASE}/${DATE}/**"
      ],
      "timeoutMs": 120000,
      "ratePerMinute": 20,
      "concurrency": 1
    },
    {
      "tool": "billing.switchFixtures",
      "allow": [
        "designer",
        "maintainer"
      ],
      "writes": [
        "${BASE}/${DATE}/**"
      ],
      "timeoutMs": 90000,
      "ratePerMinute": 20,
      "concurrency": 1
    },
    {
      "tool": "code.generate",
      "description": "Read-only generation includes complete React/Vue workflow application artifacts; no execution or installation.",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "design.compose",
      "description": "Read-only composition includes workflow context: four screens, routes, states and trait actions.",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "pipeline",
      "allow": [
        "designer",
        "maintainer"
      ],
      "writes": [
        ".oods/schemas/**"
      ],
      "timeoutMs": 60000,
      "ratePerMinute": 40,
      "concurrency": 2
    },
    {
      "tool": "registry.snapshot",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "health",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "viz.compose",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "viz.render",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "artifact.certify",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "brand.intake",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "dashboard.render",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "design.preview",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 150000,
      "ratePerMinute": 10,
      "concurrency": 1
    },
    {
      "tool": "fidelity.preview",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 30,
      "concurrency": 4
    },
    {
      "tool": "map",
      "allow": [
        "designer",
        "maintainer"
      ],
      "writes": [
        "artifacts/structured-data/component-mappings.json",
        ".oods/conflicts/**"
      ],
      "timeoutMs": 60000,
      "ratePerMinute": 30,
      "concurrency": 1
    },
    {
      "tool": "schema",
      "allow": [
        "designer",
        "maintainer"
      ],
      "writes": [
        ".oods/schemas/**"
      ],
      "timeoutMs": 30000,
      "ratePerMinute": 30,
      "concurrency": 1
    },
    {
      "tool": "object",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "repl",
      "allow": [
        "designer",
        "maintainer"
      ],
      "writes": [
        "${BASE}/${DATE}/**"
      ],
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    },
    {
      "tool": "review",
      "allow": [
        "designer",
        "maintainer"
      ],
      "readOnly": true,
      "timeoutMs": 30000,
      "ratePerMinute": 60,
      "concurrency": 4
    }
  ],
  "limits": {
    "defaultTimeoutMs": 120000,
    "concurrency": 1,
    "ratePerMinute": 60
  },
  "redactions": [
    "$HOME",
    "GITHUB_TOKEN",
    "/Users/*/secrets/*",
    "CHROMATIC_PROJECT_TOKEN"
  ]
}
