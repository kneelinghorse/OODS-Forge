exports[`dashboard.render render-fidelity goldens (sprint-113 m06) > the metric-overview composed payload matches the committed golden 1`] = `
{
  "a11y": {
    "description": "Revenue overview dashboard.",
    "panelOrder": [
      "kpi-rev",
      "trend",
      "breakdown",
      "geo",
    ],
    "readingOrder": "kpi-first",
  },
  "layout": [
    {
      "h": 1,
      "id": "kpi-rev",
      "w": 3,
      "x": 0,
      "y": 0,
    },
    {
      "h": 2,
      "id": "trend",
      "w": 6,
      "x": 3,
      "y": 0,
    },
    {
      "h": 2,
      "id": "breakdown",
      "w": 6,
      "x": 0,
      "y": 2,
    },
    {
      "h": 2,
      "id": "geo",
      "w": 6,
      "x": 6,
      "y": 2,
    },
  ],
  "links": [
    {
      "operator": "in",
      "source": "breakdown",
      "sourceField": "region",
      "target": "trend",
    },
  ],
  "meta": {
    "crossFiltered": false,
    "datasetCount": 1,
    "errorPanelCount": 0,
    "panelCount": 4,
  },
  "output": {
    "compact": true,
  },
  "panels": [
    {
      "a11yDescription": "Total Revenue: 390 (increasing, delta 90).",
      "delta": 90,
      "deltaPct": 0.3,
      "formatted": "390",
      "id": "kpi-rev",
      "kind": "kpi",
      "sparkline": [
        100,
        80,
        120,
        90,
      ],
      "thresholdBreached": true,
      "title": "Total Revenue",
      "trendDirection": "increasing",
      "value": 390,
    },
    {
      "a11yDescription": "Line chart of sum of revenue by month.",
      "chartType": "line",
      "id": "trend",
      "kind": "chart",
      "renderer": "vega-lite",
      "spec": {
        "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
        "data": {
          "values": [
            {
              "month": "Jan",
              "region": "West",
              "revenue": 100,
            },
            {
              "month": "Jan",
              "region": "East",
              "revenue": 80,
            },
            {
              "month": "Feb",
              "region": "West",
              "revenue": 120,
            },
            {
              "month": "Feb",
              "region": "East",
              "revenue": 90,
            },
          ],
        },
        "description": "Line chart of sum of revenue by month.",
        "encoding": {
          "x": {
            "field": "month",
            "type": "ordinal",
          },
          "y": {
            "aggregate": "sum",
            "field": "revenue",
            "type": "quantitative",
          },
        },
        "mark": {
          "type": "line",
        },
        "title": "Line chart",
        "usermeta": {
          "oods": {
            "a11y": {
              "description": "Line chart of sum of revenue by month.",
            },
            "name": "Line chart",
            "specId": "trend",
          },
