      "stroke": null,
    },
  },
  "data": {
    "values": [
      {
        "quarter": "2024-01",
        "region": "North",
        "revenue": 120000,
        "units": 340,
      },
      {
        "quarter": "2024-01",
        "region": "South",
        "revenue": 135000,
        "units": 410,
      },
      {
        "quarter": "2024-02",
        "region": "North",
        "revenue": 128000,
        "units": 360,
      },
      {
        "quarter": "2024-02",
        "region": "South",
        "revenue": 142000,
        "units": 430,
      },
      {
        "quarter": "2024-03",
        "region": "North",
        "revenue": 131000,
        "units": 372,
      },
      {
        "quarter": "2024-03",
        "region": "South",
        "revenue": 150000,
        "units": 455,
      },
    ],
  },
  "description": "Area chart of sum of revenue by quarter.",
  "encoding": {
    "x": {
      "field": "quarter",
      "scale": {
        "type": "time",
      },
      "title": "Quarter",
      "type": "temporal",
    },
    "y": {
      "aggregate": "sum",
      "field": "revenue",
      "title": "Revenue",
      "type": "quantitative",
    },
  },
  "mark": {
    "color": "#416CD9",
    "type": "area",
  },
  "title": "Area chart",
  "usermeta": {
    "oods": {
      "a11y": {
        "ariaLabel": "Area chart of Revenue by Quarter",
        "description": "Area chart of sum of revenue by quarter.",
      },
      "name": "Area chart",
      "portability": {
        "tableColumnOrder": [
          "quarter",
          "revenue",
          "region",
          "units",
        ],
      },
      "specId": "viz:area",
    },
  },
}
`;

