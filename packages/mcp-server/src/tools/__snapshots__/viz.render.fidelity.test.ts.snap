      "labelFont": "'DM Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "titleColor": "#2D313A",
      "titleFont": "'DM Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif",
    },
    "title": {
      "anchor": "start",
      "color": "#2D313A",
