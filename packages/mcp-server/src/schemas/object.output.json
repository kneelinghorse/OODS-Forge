{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "object output",
  "description": "Grouped output for the object.* read family. anyOf (not oneOf) — per-action outputs are structurally distinct here, but anyOf is the safe consolidation contract: a handler result is valid if it matches the corresponding per-action output body. Each branch is the verbatim body of object.<action>.output.json.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "domain": { "type": "string" },
              "version": { "type": "string" },
              "maturity": { "type": ["string", "null"] },
              "description": { "type": "string" },
              "traits": {
                "type": "array",
                "items": { "type": "string" }
              },
              "fieldCount": { "type": "integer" },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["name", "domain", "version", "maturity", "description", "traits", "fieldCount", "tags"],
            "additionalProperties": false
          }
        },
        "totalCount": { "type": "integer" },
        "filters": {
          "type": "object",
          "properties": {
            "domain": { "type": ["string", "null"] },
            "maturity": { "type": ["string", "null"] },
            "trait": { "type": ["string", "null"] }
          },
          "required": ["domain", "maturity", "trait"],
          "additionalProperties": false
        }
      },
      "required": ["objects", "totalCount", "filters"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "domain": { "type": "string" },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "maturity": { "type": ["string", "null"] },
        "traits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "alias": { "type": ["string", "null"] },
              "parameters": { "type": ["object", "null"] }
            },
            "required": ["name", "alias", "parameters"],
            "additionalProperties": false
          }
        },
        "schema": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "required": { "type": "boolean" },
              "description": { "type": "string" },
              "default": {},
              "defaultFromParameter": { "type": "string" },
              "validation": {
                "type": "object"
              }
            },
            "required": ["type", "required", "description"],
            "additionalProperties": true
          }
        },
        "semantics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "semantic_type": { "type": "string" },
              "token_mapping": { "type": "string" },
              "ui_hints": {
                "type": "object",
                "additionalProperties": { "type": ["string", "boolean", "number"] }
              }
            },
            "required": ["semantic_type", "token_mapping"],
            "additionalProperties": false
          }
        },
        "viewExtensions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "component": { "type": "string" },
                "position": { "type": "string" },
                "priority": { "type": "number" },
                "props": { "type": "object" }
              },
              "required": ["component"],
              "additionalProperties": false
            }
          }
        },
        "tokens": {
          "type": "object"
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "filePath": { "type": "string" }
      },
      "required": ["name", "version", "domain", "description", "tags", "maturity", "traits", "schema", "semantics", "viewExtensions", "tokens", "warnings", "filePath"],
      "additionalProperties": false
    }
  ]
}
