{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "server",
    "registry",
    "tokens",
    "schemas",
    "latency",
    "productReality"
  ],
  "properties": {
    "productReality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "release",
        "tools",
        "viz"
      ],
      "properties": {
        "tools": {
          "description": "Source-test tier census over the registered tools. Imports are not runtime certification; null when the ledger is missing or invalid.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "entries",
            "byTier",
            "head"
          ],
          "properties": {
            "entries": {
              "type": "integer",
              "const": 24
            },
            "byTier": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "product-reality",
                "contract",
                "unit",
                "none"
              ],
              "properties": {
                "product-reality": {
                  "type": "integer",
                  "minimum": 0
                },
                "contract": {
                  "type": "integer",
                  "minimum": 0
                },
                "unit": {
                  "type": "integer",
                  "minimum": 0
                },
                "none": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "runtime": {
          "description": "Measured complete current population; null when its ledger is missing or invalid. Counts do not imply craft or classification approval.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "cells",
            "pass",
            "typedGap",
            "fail",
            "head"
          ],
          "properties": {
            "cells": {
              "type": "integer",
              "const": 154
            },
            "pass": {
              "type": "integer",
              "minimum": 0
            },
            "typedGap": {
              "type": "integer",
              "minimum": 0
            },
            "fail": {
              "type": "integer",
              "minimum": 0
            },
            "head": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "viz": {
          "description": "Generated visualization taxonomy and Core Analytics Profile census. Surface-complete cells have public SVG backing; typed gaps retain reasons in the taxonomy. Counts do not imply certification. Null when the taxonomy is missing or invalid.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "types",
            "patterns",
            "families",
            "classified",
            "coreCells",
            "coreSurfaceComplete",
            "typedGaps"
          ],
          "properties": {
            "types": {
              "type": "integer",
              "minimum": 0
            },
            "patterns": {
              "type": "integer",
              "minimum": 0
            },
            "families": {
              "type": "integer",
              "minimum": 0
            },
            "classified": {
              "type": "integer",
              "minimum": 0
            },
            "coreCells": {
              "type": "integer",
              "minimum": 0
            },
            "coreSurfaceComplete": {
              "type": "integer",
              "minimum": 0
            },
            "typedGaps": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "release": {
          "description": "Measured extracted-bundle reference applications, with exact generated-artifact equality to the host and the pinned runtime gates. The bundle head and archive hash identify the executed artifact; null when the ledger is missing or invalid.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "bundleHead",
            "archiveSha256",
            "apps",
            "frameworks",
            "cells",
            "pass",
            "typedGap",
            "fail"
          ],
          "properties": {
            "bundleHead": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "archiveSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "apps": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Organization",
                  "Subscription",
                  "User"
                ]
              },
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true
            },
            "frameworks": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "react",
                  "vue"
                ]
              },
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            },
            "cells": {
              "type": "integer",
              "const": 42
            },
            "pass": {
              "type": "integer",
              "minimum": 0,
              "maximum": 42
            },
            "typedGap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 42
            },
            "fail": {
              "type": "integer",
              "const": 0
            }
          }
        }
      },
      "description": "Runtime, portable release, tool and visualization evidence summaries. Release identifies the measured bundle archive and 42 reference-application cells with artifact parity to the host; unavailable ledgers are null."
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded"
      ]
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "uptime"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "uptime": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "traits",
        "objects",
        "lastSync"
      ],
      "properties": {
        "components": {
          "type": "integer",
          "minimum": 0
        },
        "traits": {
          "type": "integer",
          "minimum": 0
        },
        "objects": {
          "type": "integer",
          "minimum": 0
        },
        "lastSync": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "built",
        "brands",
        "themes",
        "scopes",
        "defaultScope"
      ],
      "properties": {
        "built": {
          "type": "boolean"
        },
        "brands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scopes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "defaultScope": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "brand",
            "theme",
            "source"
          ],
          "properties": {
            "brand": {
              "type": "string"
            },
            "theme": {
              "type": "string"
            },
            "source": {
              "enum": [
                "env",
                "default"
              ]
            }
          },
          "description": "Configured default chosen from built scopes; never an observed active consumer scope. Null when no scopes are built."
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "savedCount",
        "storeDir"
      ],
      "properties": {
        "savedCount": {
          "type": "integer",
          "minimum": 0
        },
        "storeDir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "latency": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dslVersion": {
      "type": "string",
      "description": "Current DSL version of this server."
    },
    "changelog": {
      "type": "array",
      "description": "DSL version changelog entries, included when requested via includeChangelog input.",
      "items": {
        "type": "object",
        "required": [
          "version",
          "date",
          "changes",
          "breaking"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "breaking": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
