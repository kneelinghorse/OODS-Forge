{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designlab.local/schemas/repl.ui.schema.json",
  "title": "Agentic REPL UI Schema",
  "type": "object",
  "required": ["version", "screens"],
  "properties": {
    "workflow": { "$ref": "#/$defs/workflow" },
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "dsVersion": { "type": "string" },
    "theme": { "type": "string" },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/uiElement" }
    },
    "tokenOverrides": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Object-level semantic token overrides. Keys are token paths (e.g., 'billing.subscription.status.active'), values are CSS variable references (e.g., 'var(--semantic-success)')."
    },
    "objectSchema": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/fieldSchemaEntry" },
      "description": "Object field schema for codegen. Maps field names to type metadata from composed object traits."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "chartDeclaration": {
      "description": "Read-only payment chart rendered by public viz.render during code generation. Workflow SVGs are static per seed record; consumers may replace the typed svg prop.",
      "type": "object",
      "additionalProperties": false,
      "required": ["chartType", "source", "dateFields", "amountField", "minorUnits", "currencyField"],
      "properties": {
        "chartType": { "const": "area" },
        "source": { "const": "payment-events" },
        "dateFields": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "amountField": { "type": "string", "minLength": 1 },
        "minorUnits": { "type": "number", "exclusiveMinimum": 0 },
        "currencyField": { "type": "string", "minLength": 1 },
        "brand": { "enum": ["A", "B"] }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object",
        "screens",
        "transitions",
        "states",
        "data"
      ],
      "properties": {
        "object": {
          "type": "string",
          "minLength": 1
        },
        "screens": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "context",
              "route"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string",
                "enum": [
                  "list",
                  "detail",
                  "form",
                  "timeline"
                ]
              },
              "route": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "from",
              "to",
              "effect"
            ],
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "enum": [
                  "list",
                  "detail",
                  "form",
                  "timeline"
                ]
              },
              "to": {
                "type": "string",
                "enum": [
                  "list",
                  "detail",
                  "form",
                  "timeline"
                ]
              },
              "effect": {
                "type": "string",
                "enum": [
                  "navigate",
                  "save",
                  "pending_cancellation",
                  "archive"
                ]
              }
            }
          }
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "loading",
              "empty",
              "error",
              "success"
            ]
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idField",
            "traits",
            "sampleCount",
            "lifecycleStates",
            "billingIntervals",
            "currency",
            "minorUnits"
          ],
          "properties": {
            "addressRoles": { "type": "array", "items": { "type": "string" } },
            "defaultAddressRole": { "type": "string" },
            "recordedEvents": { "type": "array", "items": { "type": "string" } },
            "cancellationRequiresReason": { "type": "boolean" },
            "cancellationReasonCodes": { "type": "array", "items": { "type": "string" } },
            "idField": {
              "type": "string",
              "minLength": 1
            },
            "traits": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sampleCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "lifecycleStates": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "billingIntervals": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "currency": {
              "type": "string",
              "minLength": 1
            },
            "minorUnits": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "fieldSchemaEntry": {
      "type": "object",
      "required": ["type", "required"],
      "properties": {
        "type": { "type": "string", "description": "Field data type (string, integer, number, boolean, datetime, email, etc.)." },
        "required": { "type": "boolean", "description": "Whether the field is required." },
        "description": { "type": "string", "description": "Human-readable field description." },
        "enum": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed values for enum-constrained fields."
        },
        "semanticType": { "type": "string", "description": "Semantic type from the object's semantic mapping (e.g., 'billing.subscription.status')." }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["stack", "grid", "inline", "section", "sidebar"] },
        "align": { "type": "string", "enum": ["start", "center", "end", "space-between"] },
        "gapToken": { "type": "string" }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "spacingToken": { "type": "string" },
        "radiusToken": { "type": "string" },
        "shadowToken": { "type": "string" },
        "colorToken": { "type": "string" },
        "typographyToken": { "type": "string" }
      },
      "additionalProperties": true
    },
    "meta": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "intent": { "type": "string" },
        "notes": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidenceLevel": { "type": "string", "enum": ["high", "medium", "low"] },
        "unresolvedEntity": {
          "type": "string",
          "description": "Raw Stage1 `entity-<slug>` id retained on a composed node when the OODS entity resolver could not map it to an indexed object (Path B, Sprint 89). Consumers surface this so authors can fill the alias table incrementally."
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "props": {
      "type": "object",
      "additionalProperties": true
    },
    "uiElement": {
      "type": "object",
      "required": ["id", "component"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "state": {
          "type": "string",
          "minLength": 1,
          "description": "Workflow-state branch name. Canonical names are checked semantically so draft generation can preserve an unknown name as a warning."
        },
        "route": { "type": "string" },
        "layout": { "$ref": "#/$defs/layout" },
        "style": { "$ref": "#/$defs/style" },
        "props": { "$ref": "#/$defs/props" },
        "chart": { "$ref": "#/$defs/chartDeclaration" },
        "bindings": { "$ref": "#/$defs/bindings" },
        "collection": {
          "type": "object",
          "required": [
            "source",
            "keyField",
            "labelField"
          ],
          "properties": {
            "source": {
              "enum": [
                "rows",
                "events"
              ]
            },
            "keyField": {
              "type": "string",
              "minLength": 1
            },
            "labelField": {
              "type": "string",
              "minLength": 1
            },
            "historyField": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "collectionControl": {
          "enum": [
            "search",
            "filter",
            "sort",
            "page",
            "archive",
            "open",
            "event",
            "payment-event",
            "empty"
          ]
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/uiElement" }
        },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "additionalProperties": false
    }
  }
}
