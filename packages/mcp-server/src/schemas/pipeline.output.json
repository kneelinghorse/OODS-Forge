{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designlab.local/schemas/pipeline.output.json",
  "title": "Pipeline output",
  "description": "Aggregated pipeline response with partial results and explicit failure step metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["compose", "pipeline"],
  "properties": {
    "schemaRef": {
      "type": "string",
      "description": "Schema reference returned by compose, reusable across tools."
    },
    "schemaRefCreatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the schemaRef was created."
    },
    "schemaRefExpiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the schemaRef expires. Use schema.save to persist before expiry."
    },
    "schemaRefTtlWarning": {
      "type": "object",
      "additionalProperties": false,
      "description": "Proactive warning when schemaRef TTL is approaching expiration (< 5 minutes remaining).",
      "required": ["message", "remainingMs", "recommendation"],
      "properties": {
        "message": {
          "type": "string",
          "description": "Human-readable warning message."
        },
        "remainingMs": {
          "type": "number",
          "description": "Milliseconds remaining until schemaRef expires."
        },
        "recommendation": {
          "type": "string",
          "description": "Actionable recommendation for the agent."
        }
      }
    },
    "compose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "componentCount"],
      "properties": {
        "object": { "type": "string" },
        "context": { "type": "string" },
        "layout": { "type": "string" },
        "componentCount": { "type": "number", "minimum": 0 },
        "resolvedActions": {
          "type": "array",
          "description": "Sprint 88: verbs grouped by trait after action_mappings reconciliation.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trait", "verbs"],
            "properties": {
              "trait": { "type": "string" },
              "verbs": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors", "warnings"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "invalid", "skipped"]
        },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meta"],
      "properties": {
        "html": {
          "type": "string",
          "description": "Rendered HTML when renderApply=true."
        },
        "tokenCssRef": {
          "type": "string",
          "description": "Reference to token CSS artifact when compact mode is enabled."
        },
        "meta": {
          "type": "object",
          "additionalProperties": true,
          "description": "Render metadata summary."
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "styling", "artifact", "output"],
      "properties": {
        "framework": {
          "type": "string",
          "enum": ["react", "vue", "html"]
        },
        "styling": {
          "type": "string",
          "enum": ["inline", "tokens", "tailwind"]
        },
        "artifact": {
          "$ref": "#/$defs/generatedArtifact",
          "description": "Primary code-generation payload carried without flattening."
        },
        "output": {
          "type": "string",
          "deprecated": true,
          "description": "Deprecated v0 compatibility alias for artifact.files[0].contents."
        }
      }
    },
    "saved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "One-line natural language description of what was generated."
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "totalNodes": { "type": "integer", "minimum": 0 },
        "componentsUsed": { "type": "integer", "minimum": 0 },
        "fieldsBound": { "type": "integer", "minimum": 0 },
        "responseBytes": { "type": "integer", "minimum": 0 },
        "fieldsOmitted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "reason"],
            "properties": {
              "field": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      },
      "description": "Quality metrics for the pipeline output."
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "duration"],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["compose", "validate", "render", "codegen", "save"]
          }
        },
        "stepLatency": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "description": "Per-step latency in milliseconds."
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "code", "message"],
      "properties": {
        "step": {
          "type": "string",
          "enum": ["compose", "validate", "render", "codegen", "save"]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "generatedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "framework", "files", "dependencies", "actions", "contentHash"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "framework": {
          "type": "string",
          "enum": ["react", "vue", "html"]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/generatedArtifactFile" }
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/generatedDependency" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/generatedArtifactAction" },
          "description": "Required consumer-supplied domain actions in deterministic name order. An empty array means the generated UI needs no domain-action injection."
        },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "generatedArtifactFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contents", "contentHash"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
        },
        "contents": { "type": "string" },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "generatedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "kind": {
          "type": "string",
          "enum": ["dependency", "peerDependency"]
        }
      }
    },
    "generatedArtifactAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parameters", "sources"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[$_\\p{ID_Start}][$_\\u200c\\u200d\\p{ID_Continue}]*$",
          "description": "Consumer injection name shared by all compatible occurrences."
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/generatedArtifactActionParameter" },
          "description": "Cross-framework parameter contract in canonical semantic call order."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/generatedArtifactActionSource" },
          "description": "Every schema occurrence that raises this action, in deterministic node-event-component order."
        }
      }
    },
    "generatedArtifactActionParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Portable TypeScript-style parameter type shared across framework targets."
        }
      }
    },
    "generatedArtifactActionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "component", "event"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "issue": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "path": { "type": "string" },
        "hint": { "type": "string" },
        "severity": { "type": "string" },
        "nodeId": { "type": "string" },
        "component": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
