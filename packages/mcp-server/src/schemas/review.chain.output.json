{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designlab.local/schemas/review.chain.output.json",
  "title": "review.chain output",
  "description": "Composite C5 chain output: queue + resolutions + auditTrail + per-flagged conflictDetails + apply-summary artifact + chain diagnostics. Each artifact's deep shape is validated separately at the per-emitter level (review-queue.output.json, conflict-detail.output.json, apply-summary.output.json). This schema enforces the top-level chain shape only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queue",
    "resolutions",
    "auditTrail",
    "conflictDetails",
    "summary",
    "diagnostics"
  ],
  "properties": {
    "queue": {
      "type": "object",
      "description": "Review-queue artifact. Deep shape validated by review-queue.output.json."
    },
    "resolutions": {
      "type": "array",
      "description": "Per-entity policy resolutions from review.resolve.",
      "items": {
        "type": "object",
        "required": ["urn", "decision", "reason", "policyId"],
        "properties": {
          "urn": { "type": "string" },
          "decision": { "type": "string", "enum": ["accept", "patch", "defer", "dismiss"] },
          "reason": { "type": "string" },
          "policyId": { "type": "string" },
          "evaluatedScore": { "type": ["number", "null"] },
          "evaluatedTier": { "type": "string", "enum": ["high", "medium", "low", "unknown"] }
        }
      }
    },
    "auditTrail": {
      "type": "object",
      "description": "review.resolve audit trail echoed verbatim."
    },
    "conflictDetails": {
      "type": "array",
      "description": "One entry per flaggedForReview entry in queue.entries. detail deep shape validated by conflict-detail.output.json.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["urn", "detail"],
        "properties": {
          "urn": { "type": "string" },
          "detail": { "type": "object" }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Apply-summary artifact. Deep shape validated by apply-summary.output.json."
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "fixtureSource", "entityCount", "flaggedCount"],
      "properties": {
        "fixture": { "type": "string" },
        "fixtureSource": { "type": "string", "enum": ["allow-list"] },
        "policyBundleId": { "type": "string" },
        "entityCount": { "type": "integer", "minimum": 0 },
        "flaggedCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
