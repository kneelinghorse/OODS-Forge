{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://designlab.local/schemas/review.output.json",
  "title": "review output (grouped)",
  "description": "Grouped output schema for the review family. anyOf (NOT oneOf) of each per-action output body: per-action outputs share fields (e.g. resolutions/auditTrail/diagnostics) and would match more than one oneOf branch. Each action's exact output schema body is reproduced under $defs and referenced here, so a result valid under the old per-action output schema is valid under this grouped schema, and vice versa for the union.",
  "anyOf": [
    { "$ref": "#/$defs/resolveOutput" },
    { "$ref": "#/$defs/chainOutput" }
  ],
  "$defs": {
    "resolveOutput": {
      "type": "object",
      "required": ["resolutions", "auditTrail", "warnings", "diagnostics"],
      "properties": {
        "resolutions": {
          "type": "array",
          "items": { "$ref": "#/$defs/resolveOutput_resolution" }
        },
        "auditTrail": {
          "type": "object",
          "required": ["evaluatedAt", "defaultAction", "entityCount", "policyBundle", "matchedPolicyIds"],
          "properties": {
            "evaluatedAt": {
              "type": "string",
              "format": "date-time",
              "description": "ISO timestamp of evaluation. Echoed for reproducibility."
            },
            "defaultAction": { "$ref": "#/$defs/resolveOutput_decision" },
            "entityCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of entities that produced a resolution (entities without a urn are skipped and counted in warnings)."
            },
            "policyBundle": {
              "type": "object",
              "description": "Verbatim echo of the input policy bundle for reproducibility."
            },
            "matchedPolicyIds": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Sorted unique policy IDs that matched at least one entity."
            }
          },
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "diagnostics": {
          "type": "object",
          "required": ["source", "manifestPath"],
          "properties": {
            "source": {
              "type": "string",
              "enum": ["inline", "file"]
            },
            "manifestPath": {
              "type": ["string", "null"],
              "description": "Resolved manifest path when source=file. Always relative to projectRoot."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resolveOutput_decision": {
      "type": "string",
      "enum": ["accept", "patch", "defer", "dismiss"]
    },
    "resolveOutput_tier": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "resolveOutput_resolution": {
      "type": "object",
      "required": ["urn", "decision", "reason", "policyId", "evaluatedScore", "evaluatedTier"],
      "properties": {
        "urn": { "type": "string" },
        "decision": { "$ref": "#/$defs/resolveOutput_decision" },
        "reason": { "type": "string" },
        "policyId": {
          "type": "string",
          "description": "ID of the matching policy, or 'default' when no policy matched."
        },
        "evaluatedScore": {
          "type": ["number", "null"],
          "description": "Total score from confidence_decomposition. Null when the field is absent."
        },
        "evaluatedTier": { "$ref": "#/$defs/resolveOutput_tier" }
      },
      "additionalProperties": false
    },
    "chainOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue",
        "resolutions",
        "auditTrail",
        "conflictDetails",
        "summary",
        "diagnostics"
      ],
      "properties": {
        "queue": {
          "type": "object",
          "description": "Review-queue artifact. Deep shape validated by review-queue.output.json."
        },
        "resolutions": {
          "type": "array",
          "description": "Per-entity policy resolutions from review.resolve.",
          "items": {
            "type": "object",
            "required": ["urn", "decision", "reason", "policyId"],
            "properties": {
              "urn": { "type": "string" },
              "decision": { "type": "string", "enum": ["accept", "patch", "defer", "dismiss"] },
              "reason": { "type": "string" },
              "policyId": { "type": "string" },
              "evaluatedScore": { "type": ["number", "null"] },
              "evaluatedTier": { "type": "string", "enum": ["high", "medium", "low", "unknown"] }
            }
          }
        },
        "auditTrail": {
          "type": "object",
          "description": "review.resolve audit trail echoed verbatim."
        },
        "conflictDetails": {
          "type": "array",
          "description": "One entry per flaggedForReview entry in queue.entries. detail deep shape validated by conflict-detail.output.json.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["urn", "detail"],
            "properties": {
              "urn": { "type": "string" },
              "detail": { "type": "object" }
            }
          }
        },
        "summary": {
          "type": "object",
          "description": "Apply-summary artifact. Deep shape validated by apply-summary.output.json."
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixture", "fixtureSource", "entityCount", "flaggedCount"],
          "properties": {
            "fixture": { "type": "string" },
            "fixtureSource": { "type": "string", "enum": ["allow-list"] },
            "policyBundleId": { "type": "string" },
            "entityCount": { "type": "integer", "minimum": 0 },
            "flaggedCount": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
