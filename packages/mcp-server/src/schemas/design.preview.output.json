{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designlab.local/schemas/design.preview.output.json",
  "title": "Design preview output",
  "description": "The URL of the generated app running in the preview host, one per compiled framework, with the stored record, the schema hash and the compiled module digests. An unreachable host throws OODS-N021 before any record is written.",
  "type": "object",
  "required": [
    "status",
    "schemaHash",
    "key",
    "previewUrl",
    "previews",
    "host",
    "brand",
    "theme",
    "recordPath",
    "durationMs"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "ok"
    },
    "schemaHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Canonical hash of the composed schema; the preview key is its first sixteen hex characters."
    },
    "key": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "previewUrl": {
      "type": "string",
      "format": "uri",
      "description": "The first compiled framework's page; open it in a browser."
    },
    "previews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["framework", "url", "moduleUrl", "artifactContentHash", "compiled"],
        "additionalProperties": false,
        "properties": {
          "framework": { "type": "string", "enum": ["react", "vue"] },
          "url": { "type": "string", "format": "uri" },
          "moduleUrl": { "type": "string", "format": "uri", "description": "The artifact compiled to one ESM module; fetched once here so a compile failure fails this call." },
          "artifactContentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "compiled": {
            "type": "object",
            "required": ["bytes", "sha256"],
            "additionalProperties": false,
            "properties": {
              "bytes": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "host": {
      "type": "object",
      "required": ["url", "port", "previewsDir"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "previewsDir": { "type": "string", "description": "Where the record was written and where the host reads it; beside the saved-schema store." }
      }
    },
    "brand": { "type": "string", "enum": ["A", "B"] },
    "theme": { "type": "string", "enum": ["light", "dark", "hc"] },
    "recordPath": { "type": "string" },
    "durationMs": {
      "type": "number",
      "minimum": 0
    }
  }
}
