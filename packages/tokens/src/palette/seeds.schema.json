{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "brands",
    "viz"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "brands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "accent",
            "neutral",
            "status",
            "dark"
          ],
          "properties": {
            "primary": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hue",
                "chromaPeak"
              ],
              "properties": {
                "hue": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                "chromaPeak": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 0.4
                }
              }
            },
            "accent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hue",
                "chromaPeak"
              ],
              "properties": {
                "hue": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                "chromaPeak": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 0.4
                }
              }
            },
            "neutral": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hue",
                "chromaPeak"
              ],
              "properties": {
                "hue": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                "chromaPeak": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 0.4
                }
              }
            },
            "status": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "info",
                "success",
                "warning",
                "critical",
                "archive"
              ],
              "properties": {
                "info": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "hue",
                    "chromaPeak"
                  ],
                  "properties": {
                    "hue": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 360
                    },
                    "chromaPeak": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 0.4
                    }
                  }
                },
                "success": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "hue",
                    "chromaPeak"
                  ],
                  "properties": {
                    "hue": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 360
                    },
                    "chromaPeak": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 0.4
                    }
                  }
                },
                "warning": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "hue",
                    "chromaPeak"
                  ],
                  "properties": {
                    "hue": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 360
                    },
                    "chromaPeak": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 0.4
                    }
                  }
                },
                "critical": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "hue",
                    "chromaPeak"
                  ],
                  "properties": {
                    "hue": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 360
                    },
                    "chromaPeak": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 0.4
                    }
                  }
                },
                "archive": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "hue",
                    "chromaPeak"
                  ],
                  "properties": {
                    "hue": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 360
                    },
                    "chromaPeak": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 0.4
                    }
                  }
                }
              }
            },
            "dark": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canvasLightness",
                "elevationDelta",
                "canvasChroma",
                "accentChromaScale"
              ],
              "properties": {
                "canvasLightness": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 0.3
                },
                "elevationDelta": {
                  "type": "number",
                  "minimum": 0.02,
                  "maximum": 0.05
                },
                "canvasChroma": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.012
                },
                "accentChromaScale": {
                  "type": "number",
                  "minimum": 0.3,
                  "maximum": 1
                }
              }
            }
          }
        },
        "B": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primaryHue"
          ],
          "properties": {
            "primaryHue": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            }
          }
        }
      }
    },
    "viz": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categorical",
        "sequential",
        "diverging"
      ],
      "properties": {
        "categorical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hueOffset",
            "light",
            "dark"
          ],
          "properties": {
            "hueOffset": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "light": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "lightness",
                  "chromaPeak"
                ],
                "properties": {
                  "lightness": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 0.99
                  },
                  "chromaPeak": {
                    "type": "number",
                    "minimum": 0.045,
                    "maximum": 0.4
                  }
                }
              }
            },
            "dark": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "lightness",
                  "chromaPeak"
                ],
                "properties": {
                  "lightness": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 0.99
                  },
                  "chromaPeak": {
                    "type": "number",
                    "minimum": 0.045,
                    "maximum": 0.4
                  }
                }
              }
            }
          }
        },
        "sequential": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hue",
            "chromaPeak"
          ],
          "properties": {
            "hue": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "chromaPeak": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 0.4
            }
          }
        },
        "diverging": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "negativeHue",
            "positiveHue",
            "chromaPeak"
          ],
          "properties": {
            "negativeHue": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "positiveHue": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "chromaPeak": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 0.4
            }
          }
        }
      }
    }
  }
}
