{
  "name": "@oods/component-styles",
  "version": "0.1.0",
  "description": "Token-driven shared CSS contract for OODS React and Vue components.",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20.11.1"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsup --config tsup.config.ts && node scripts/copy-css.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ported": {
      "types": "./dist/ported.d.ts",
      "import": "./dist/ported.js",
      "require": "./dist/ported.cjs"
    },
    "./css": {
      "default": "./dist/components.css"
    },
    "./css-ported": {
      "default": "./dist/components.css"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@oods/tokens": "0.1.0"
  },
  "devDependencies": {
    "@oods/component-contracts": "0.1.0",
    "playwright": "^1.56.1"
  },
  "packageManager": "pnpm@9.12.2"
}
