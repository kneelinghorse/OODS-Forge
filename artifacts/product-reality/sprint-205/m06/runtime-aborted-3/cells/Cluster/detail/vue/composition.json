    "objectSchema": {
      "label": {
        "type": "string",
        "required": true,
        "description": "Human-readable display name rendered in primary surfaces.",
        "semanticType": "text.label"
      },
      "description": {
        "type": "string",
        "required": false,
        "description": "Supporting description used in detail and card contexts.",
        "semanticType": "text.description"
      },
      "placeholder": {
        "type": "string",
        "required": false,
        "description": "Hint copy surfaced in form fields when the label is empty.",
        "semanticType": "text.placeholder"
      },
      "created_at": {
        "type": "datetime",
        "required": true,
        "description": "Timestamp recording when the entity was first created.",
        "semanticType": "audit.created_at"
      },
      "updated_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the most recent modification, when available.",
        "semanticType": "audit.updated_at"
      },
      "last_event": {
        "type": "string",
        "required": true,
        "description": "Lifecycle event associated with the most recent timestamp mutation.",
        "enum": [
          "updated"
        ],
        "semanticType": "audit.event.type"
      },
      "last_event_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the lifecycle event captured in last_event.",
        "semanticType": "audit.event.timestamp"
      },
      "classification_metadata": {
        "type": "ClassificationMetadata",
        "required": true,
        "description": "Operational metadata describing mode, storage model, governance rules, and audit timestamps.\n",
        "semanticType": "classification.metadata"
      },
      "categories": {
        "type": "CategoryNode[]",
        "required": false,
        "default": [],
        "description": "Ordered taxonomy nodes scoped to the object.",
        "semanticType": "classification.categories"
      },
      "primary_category_id": {
        "type": "string",
        "required": false,
        "description": "Identifier of the canonical taxonomy node.",
        "semanticType": "classification.primary"
      },
      "primary_category_path": {
        "type": "string",
        "required": false,
        "description": "Human-readable breadcrumb path (Electronics > Mobile > Android)."
      },
      "tags": {
        "type": "Tag[]",
        "required": false,
        "default": [],
        "description": "Canonical tag collection after synonym collapse.",
        "semanticType": "classification.tags"
      },
      "tag_count": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Number of canonical tags assigned to the object."
      },
      "tag_preview": {
        "type": "string",
        "required": false,
        "description": "Denormalized comma-delimited preview for list renders."
      },
      "searchQuery": {
        "type": "string",
        "required": false,
        "default": "",
        "description": "The current search query string entered by the user.",
        "semanticType": "input.search.query"
      },
      "searchActive": {
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "Whether the search input is currently focused or has a non-empty query.",
        "semanticType": "state.search.active"
      },
      "filters": {
        "type": "object[]",
        "required": false,
        "default": [],
        "description": "Array of available filter descriptors. Each entry defines a filterable dimension:\n  - field: string (the schema field to filter on)\n  - label: string (display label)\n  - type: \"select\" | \"multi-select\" | \"range\" | \"boolean\" | \"date-range\"\n  - options: array of { value, label } for select/multi-select types\n",
        "semanticType": "input.filter.descriptors"
      },
      "activeFilters": {
        "type": "object[]",
        "required": false,
        "default": [],
        "description": "Array of currently applied filter values:\n  - field: string (matches a filter descriptor field)\n  - operator: \"eq\" | \"in\" | \"range\" | \"gt\" | \"lt\" | \"between\"\n  - value: unknown (the selected filter value or values)\n",
        "semanticType": "state.filter.active"
      },
      "filterCount": {
        "type": "number",
        "required": true,
        "default": 0,
        "description": "Computed count of currently active filters.",
        "semanticType": "metric.filter.count"
      },
      "page": {
        "type": "number",
        "required": true,
        "default": 1,
        "description": "Current page number (1-based).",
        "semanticType": "state.pagination.page"
      },
      "pageSize": {
        "type": "number",
        "required": true,
        "default": 25,
        "description": "Number of items displayed per page.",
        "semanticType": "state.pagination.pageSize"
      },
      "totalItems": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Total number of items across all pages. Used to compute total page count.",
        "semanticType": "metric.pagination.totalItems"
      },
      "totalPages": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Computed total number of pages (ceil(totalItems / pageSize)).",
        "semanticType": "metric.pagination.totalPages"
      },
      "cluster_id": {
        "type": "string",
        "required": true,
        "description": "Hive's identifier for the cluster, an integer surrogate key declared as a string. Present on the entity lens; the semantic lens computes clusters on the fly and does not persist one.",
        "semanticType": "intelligence.cluster.id"
      },
      "lead_title": {
        "type": "string",
        "required": true,
        "description": "The title of the article that leads the conversation.",
        "semanticType": "text.label"
      },
      "lead_url": {
        "type": "string",
        "required": false,
        "description": "Where that article is.",
        "semanticType": "intelligence.cluster.lead_url"
      },
      "lens": {
        "type": "string",
        "required": true,
        "description": "Which clusterer produced this record. Not a detail: the two lenses answer different questions and disagree by design — entity is the persisted entity-and-title-token clusterer that the co-talker counts are built from, semantic is an on-the-fly pgvector cosine at threshold 0.80 that finds two people writing about one idea in different vocabulary. A cluster is only meaningful beside the lens that produced it.",
        "enum": [
          "entity",
          "semantic"
        ],
        "semanticType": "intelligence.cluster.lens"
      },
      "member_count": {
        "type": "number",
        "required": false,
        "description": "How many articles are in the conversation.",
        "semanticType": "intelligence.cluster.member_count"
      },
      "member_people_count": {
        "type": "number",
        "required": false,
        "description": "How many distinct cohort members are in it — the number that makes a cluster worth reading, since Hive's default is the multi-person cluster its own signal uniquely produces.",
        "semanticType": "intelligence.cluster.member_people_count"
      },
      "dominant_category": {
        "type": "string",
        "required": false,
        "description": "The category most of its articles carry. Deliberately unconstrained: the server is authoritative and an unknown category is not coerced into the cohort's topic vocabulary, which is a different list serving a different purpose.",
        "semanticType": "intelligence.cluster.dominant_category"
      },
      "is_trending": {
        "type": "boolean",
        "required": false,
        "description": "Whether Hive marks the conversation as trending.",
        "semanticType": "intelligence.cluster.is_trending"
      },
      "window_days": {
        "type": "number",
        "required": false,
        "description": "The lookback this record was read for. Every count here is only true of a window.",
        "semanticType": "intelligence.cluster.window_days"
      },
      "max_similarity": {
        "type": "number",
        "required": false,
        "description": "Semantic lens only: the strongest cosine similarity in the cluster. Absent on the entity lens, where it does not exist — absence means the lens did not produce it, never a similarity of zero.",
        "semanticType": "intelligence.cluster.max_similarity"
      },
      "mean_similarity": {
        "type": "number",
        "required": false,
        "description": "Semantic lens only, on the same terms.",
        "semanticType": "intelligence.cluster.mean_similarity"
      },
      "people": {
        "type": "object[]",
        "required": false,
        "description": "The cohort members in the conversation, as {person_id, name, primary_topic, article_count_in_cluster}. primary_topic travels with each of them so a cluster that spans several slices of the cohort can be read without a second lookup.",
        "semanticType": "intelligence.cluster.people"
      },
      "members": {
        "type": "object[]",
        "required": false,
        "description": "The articles themselves, as {article_id, title, url, published_at, category, person_id, person_name}.",
        "semanticType": "intelligence.cluster.members"
      }
    }
  },
