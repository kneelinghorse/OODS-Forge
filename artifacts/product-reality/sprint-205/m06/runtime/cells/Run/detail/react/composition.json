    "objectSchema": {
      "searchQuery": {
        "type": "string",
        "required": false,
        "default": "",
        "description": "The current search query string entered by the user.",
        "semanticType": "input.search.query"
      },
      "searchActive": {
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "Whether the search input is currently focused or has a non-empty query.",
        "semanticType": "state.search.active"
      },
      "filters": {
        "type": "object[]",
        "required": false,
        "default": [],
        "description": "Array of available filter descriptors. Each entry defines a filterable dimension:\n  - field: string (the schema field to filter on)\n  - label: string (display label)\n  - type: \"select\" | \"multi-select\" | \"range\" | \"boolean\" | \"date-range\"\n  - options: array of { value, label } for select/multi-select types\n",
        "semanticType": "input.filter.descriptors"
      },
      "activeFilters": {
        "type": "object[]",
        "required": false,
        "default": [],
        "description": "Array of currently applied filter values:\n  - field: string (matches a filter descriptor field)\n  - operator: \"eq\" | \"in\" | \"range\" | \"gt\" | \"lt\" | \"between\"\n  - value: unknown (the selected filter value or values)\n",
        "semanticType": "state.filter.active"
      },
      "filterCount": {
        "type": "number",
        "required": true,
        "default": 0,
        "description": "Computed count of currently active filters.",
        "semanticType": "metric.filter.count"
      },
      "page": {
        "type": "number",
        "required": true,
        "default": 1,
        "description": "Current page number (1-based).",
        "semanticType": "state.pagination.page"
      },
      "pageSize": {
        "type": "number",
        "required": true,
        "default": 25,
        "description": "Number of items displayed per page.",
        "semanticType": "state.pagination.pageSize"
      },
      "totalItems": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Total number of items across all pages. Used to compute total page count.",
        "semanticType": "metric.pagination.totalItems"
      },
      "totalPages": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Computed total number of pages (ceil(totalItems / pageSize)).",
        "semanticType": "metric.pagination.totalPages"
      },
      "provenance_source": {
        "type": "string",
        "required": true,
        "examples": [
          "Stage1",
          "Stage1",
          "Stage1",
          "Stage1",
          "Stage1",
          "Stage1"
        ],
        "description": "The system that produced the record.",
        "semanticType": "provenance.source"
      },
      "provenance_record": {
        "type": "string",
        "required": true,
        "examples": [
          "stage1-tracelab.aquex.ai-2026-09-18",
          "stage1-tracelab.aquex.ai-2026-09-17",
          "stage1-tracelab.aquex.ai-2026-09-17",
          "stage1-frontend-production-43c3.up.railway.app-2026-09-17",
          "stage1-designsystem.digital.gov-2026-09-17",
          "stage1-designsystem.digital.gov-2026-09-16"
        ],
        "description": "Which record there.",
        "semanticType": "provenance.record"
      },
      "provenance_locator": {
        "type": "string",
        "required": false,
        "examples": [
          "manifest.json",
          "manifest.json",
          "manifest.json",
          "manifest.json",
          "manifest.json",
          "manifest.json"
        ],
        "description": "Where in that record the values were read.",
        "semanticType": "provenance.locator"
      },
      "provenance_method": {
        "type": "string",
        "required": true,
        "examples": [
          "Stage1 app capture, 28 passes",
          "Stage1 app capture, 18 passes",
          "Stage1 app capture, 20 passes",
          "Stage1 app capture, 16 passes",
          "Stage1 app capture, 30 passes",
          "Stage1 app capture, 20 passes"
        ],
        "description": "How the values were obtained.",
        "semanticType": "provenance.method"
      },
      "provenance_at": {
        "type": "datetime",
        "required": true,
        "examples": [
          "2026-09-18T00:34:54.671Z",
          "2026-09-17T21:55:36.491Z",
          "2026-09-17T21:53:41.439Z",
          "2026-09-17T21:52:21.293Z",
          "2026-09-17T00:44:54.052Z",
          "2026-09-16T03:40:54.031Z"
        ],
        "description": "When they were obtained.",
        "semanticType": "provenance.at"
      },
      "run_id": {
        "type": "string",
        "required": true,
        "examples": [
          "d0a43821-5730-4bf3-8b40-20f6fcb6b69c",
          "edb8954d-44a6-4e48-b9d9-aad676f2bf18",
          "924005a5-e31e-4430-80ca-84c5b974fd86",
          "2af80ee6-d74f-4922-8c9e-1763b4f7c2d2",
          "6e435ce7-eaab-46b4-be6b-cea9b80defa6",
          "b78461bc-2138-49ae-a82a-188d9d01ff78"
        ],
        "description": "The capture's own id, a uuid Stage1 assigns; the directory name under out/stage1/<suite>/.",
        "semanticType": "capture.run.run_id"
      },
      "target_name": {
        "type": "string",
        "required": true,
        "examples": [
          "tracelab-production-infer",
          "tracelab-production",
          "tracelab-production",
          "tracelab-production",
          "uswds-designsystem",
          "uswds-designsystem"
        ],
        "description": "What was captured, as the run names it (targets[0].name). Every run read carries exactly one target, so the subject is two fields here rather than an object of its own.",
        "semanticType": "text.label"
      },
      "target_url": {
        "type": "string",
        "required": true,
        "examples": [
          "https://tracelab.aquex.ai/",
          "https://tracelab.aquex.ai/",
          "https://tracelab.aquex.ai/",
          "https://frontend-production-43c3.up.railway.app/",
          "https://designsystem.digital.gov/",
          "https://designsystem.digital.gov/"
        ],
        "description": "Where the capture started (targets[0].url).",
        "semanticType": "capture.run.target_url"
      },
      "mode": {
        "type": "string",
        "required": true,
        "examples": [
          "app",
          "app",
          "app",
          "app",
          "app",
          "app"
        ],
        "description": "The capture mode. Every run a run view reads is app; suite runs aggregate targets and carry no a11y report of their own.",
        "enum": [
          "app",
          "suite"
        ],
        "semanticType": "capture.run.mode"
      },
      "auth_type": {
        "type": "string",
        "required": true,
        "examples": [
          "none",
          "none",
          "none",
          "none",
          "none",
          "none"
        ],
        "description": "The authentication the manifest RECORDS. Shown as recorded, never inferred: Sprint 204 measured \"none\" on a capture that was authenticated, which is Stage1's to correct.",
        "semanticType": "capture.run.auth_type"
      },
      "page_count": {
        "type": "integer",
        "required": true,
        "examples": [
          25,
          25,
          25,
          10,
          40,
          40
        ],
        "description": "How many pages the accessibility pass read.",
        "semanticType": "capture.run.page_count"
      },
      "finding_count": {
        "type": "integer",
        "required": true,
        "examples": [
          0,
          0,
          0,
          0,
          6,
          6
        ],
        "description": "How many rule failures the run found across its pages (a11y rollup.violation_count).",
        "semanticType": "capture.run.finding_count"
      },
      "critical_count": {
        "type": "integer",
        "required": true,
        "examples": [
          0,
          0,
          0,
