    "objectSchema": {
      "plan_code": {
        "type": "string",
        "required": true,
        "description": "Provider specific identifier for the plan or price.",
        "semanticType": "billing.plan.code"
      },
      "plan_name": {
        "type": "string",
        "required": true,
        "description": "Human readable plan label rendered in list and detail contexts.",
        "semanticType": "billing.plan.name"
      },
      "billing_interval": {
        "type": "string",
        "required": true,
        "description": "Billing cadence name selected from supportedIntervals.",
        "enum": [
          "monthly",
          "quarterly",
          "annual"
        ],
        "semanticType": "billing.plan.interval"
      },
      "interval_count": {
        "type": "integer",
        "required": false,
        "default": 1,
        "description": "Multiplier for interval (ex: 12 with monthly => yearly cadence).",
        "semanticType": "billing.plan.interval_count"
      },
      "amount_minor": {
        "type": "integer",
        "required": true,
        "description": "Contract value expressed in minor currency units.",
        "semanticType": "billing.plan.amount_minor"
      },
      "currency": {
        "type": "string",
        "required": true,
        "default": "usd",
        "description": "ISO 4217 currency for the plan price.",
        "semanticType": "billing.plan.currency"
      },
      "trial_period_days": {
        "type": "integer",
        "required": false,
        "description": "Length of introductory trial period in days.",
        "semanticType": "billing.plan.trial_period_days"
      },
      "collection_method": {
        "type": "string",
        "required": false,
        "description": "How billing is collected (charge_automatically, send_invoice).",
        "semanticType": "billing.plan.collection_method"
      },
      "billing_anchor_day": {
        "type": "integer",
        "required": false,
        "description": "Day of month used to anchor renewals when prorating.",
        "semanticType": "billing.plan.billing_anchor_day"
      },
      "pricing_model": {
        "type": "string",
        "required": false,
        "default": "flat",
        "description": "Price strategy (flat, per_unit, tiered, package).",
        "semanticType": "billing.plan.pricing_model"
      },
      "meter_name": {
        "type": "string",
        "required": true,
        "description": "Friendly metered feature name shown in UI (ex: Analytics Seats).",
        "semanticType": "billing.usage.meter_name"
      },
      "included_quantity": {
        "type": "integer",
        "required": true,
        "description": "Quantity included in base plan before overages.",
        "semanticType": "billing.usage.included_quantity"
      },
      "consumed_quantity": {
        "type": "integer",
        "required": true,
        "description": "Actual quantity consumed in the active period.",
        "semanticType": "billing.usage.consumed_quantity"
      },
      "unit_label": {
        "type": "string",
        "required": true,
        "default": "seats",
        "description": "Label for display, defaults to the unit parameter.",
        "semanticType": "billing.usage.unit_label"
      },
      "period_start": {
        "type": "date",
        "required": true,
        "description": "Date the usage accumulation window began.",
        "semanticType": "billing.usage.period_start"
      },
      "period_end": {
        "type": "date",
        "required": true,
        "description": "Date the usage accumulation window ends.",
        "semanticType": "billing.usage.period_end"
      },
      "rollover_strategy": {
        "type": "string",
        "required": false,
        "default": "none",
        "description": "Strategy for unused units (inherits rolloverStrategy parameter).",
        "semanticType": "billing.usage.rollover_strategy"
      },
      "overage_rate_minor": {
        "type": "integer",
        "required": false,
        "description": "Cost per additional unit expressed in minor currency units.",
        "semanticType": "billing.usage.overage_rate_minor"
      },
      "projected_overage_minor": {
        "type": "integer",
        "required": false,
        "description": "Forecasted overage spend derived from consumption trends.",
        "semanticType": "billing.usage.projected_overage_minor"
      },
      "samples": {
        "type": "UsageSample[]",
        "required": false,
        "default": [],
        "description": "Rolling usage measurements for charts or anomaly detection.",
        "semanticType": "billing.usage.samples"
      },
      "owner_id": {
        "type": "string",
        "required": true,
        "description": "Identifier of the owning principal scoped by owner_type.",
        "semanticType": "ownership.owner.id"
      },
      "owner_type": {
        "type": "string",
        "required": true,
        "description": "Categorical owner type sourced from the ownerTypes parameter.",
        "enum": [
          "organization",
          "team",
          "user"
        ],
        "semanticType": "ownership.owner.type"
      },
      "ownership_role": {
        "type": "string",
        "required": false,
        "description": "Optional role name describing how the owner governs the entity.",
        "semanticType": "ownership.owner.role"
      },
      "ownership_transferred_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp recording when ownership was last transferred.",
        "semanticType": "ownership.owner.transferred_at"
      },
      "plan_id": {
        "type": "string",
        "required": true,
        "description": "Stable identifier for the plan within the billing domain.",
        "semanticType": "billing.plan.id"
      },
      "product_family": {
        "type": "string",
        "required": true,
        "description": "High level product family grouping for analytics and reporting.",
        "semanticType": "billing.plan.product_family"
      },
      "status": {
        "type": "string",
        "required": true,
        "description": "Availability state of the plan (active, deprecated, private_beta).",
        "enum": [
          "active",
          "deprecated",
          "private_beta",
          "legacy"
        ],
        "semanticType": "billing.plan.status"
      },
      "feature_matrix": {
        "type": "FeatureDescriptor[]",
        "required": false,
        "default": [],
        "description": "Array of feature descriptors listing entitlement tiers.",
        "semanticType": "billing.plan.feature_matrix"
      },
      "add_on_ids": {
        "type": "string[]",
        "required": false,
        "default": [],
        "description": "Identifiers for add-ons commonly sold with this plan.",
        "semanticType": "billing.plan.add_on_ids"
      },
      "upgrade_targets": {
        "type": "string[]",
        "required": false,
        "default": [],
        "description": "Plans presented as upgrade destinations.",
        "semanticType": "billing.plan.upgrade_targets"
      },
      "downgrade_targets": {
        "type": "string[]",
        "required": false,
        "default": [],
        "description": "Plans that can be downgraded to from this plan.",
        "semanticType": "billing.plan.downgrade_targets"
      },
      "notes": {
        "type": "string",
        "required": false,
        "description": "Internal commentary for packaging or finance teams.",
        "semanticType": "billing.plan.notes"
      }
    }
  },
