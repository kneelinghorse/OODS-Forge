unk_countState(value); };\nconst handleUpdate_methodologyState = ref<string>(String(methodology.value ?? ''));\nconst setHandleUpdate_methodologyState = (value: string) => { handleUpdate_methodologyState.value = value; };\n/* @oods-local-binding handleUpdate_methodology */ const handleUpdate_methodology = (value: string) => { setHandleUpdate_methodologyState(value); };\n</script>\n\n<style scoped>\n/* Token CSS variables are consumed via inline styles. */\n/* Add component-scoped overrides here as needed. */\n</style>\n",
