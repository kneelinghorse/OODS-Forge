    "objectSchema": {
      "supersession_status": {
        "type": "string",
        "required": true,
        "default": "active",
        "description": "Whether this record still stands. Named apart from Stateful's `status` so an object can carry\nboth a lifecycle and a supersession lineage.\n",
        "semanticType": "lifecycle.supersession.state"
      },
      "superseded_by": {
        "type": "string",
        "required": false,
        "description": "Identifier of the record that replaced this one. Present when the store records the forward\npointer. Absent means not replaced, or not known — the two are distinguished by\nsupersession_status, never by the pointer alone.\n",
        "semanticType": "lifecycle.supersession.replacement"
      },
      "supersedes": {
        "type": "string",
        "required": false,
        "description": "Identifier of the record this one replaced. Present when the store records the backward\npointer. Never inferred from ordering.\n",
        "semanticType": "lifecycle.supersession.replaced"
      },
      "superseded_at": {
        "type": "datetime?",
        "required": false,
        "description": "When the replacement happened, when the store records it. CMOS does not, so a Decision leaves\nit absent rather than borrowing the replacement's creation time.\n",
        "semanticType": "lifecycle.supersession.timestamp"
      },
      "supersession_reason": {
        "type": "string",
        "required": false,
        "description": "Why the record was replaced, when the store carries a reason.",
        "semanticType": "lifecycle.supersession.reason"
      },
      "created_at": {
        "type": "datetime",
        "required": true,
        "description": "Timestamp recording when the entity was first created.",
        "semanticType": "audit.created_at"
      },
      "updated_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the most recent modification, when available.",
        "semanticType": "audit.updated_at"
      },
      "last_event": {
        "type": "string",
        "required": true,
        "description": "Lifecycle event associated with the most recent timestamp mutation.",
        "enum": [
          "captured"
        ],
        "semanticType": "audit.event.type"
      },
      "last_event_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the lifecycle event captured in last_event.",
        "semanticType": "audit.event.timestamp"
      },
      "classification_metadata": {
        "type": "ClassificationMetadata",
        "required": true,
        "description": "Operational metadata describing mode, storage model, governance rules, and audit timestamps.\n",
        "semanticType": "classification.metadata"
      },
      "categories": {
        "type": "CategoryNode[]",
        "required": false,
        "default": [],
        "description": "Ordered taxonomy nodes scoped to the object.",
        "semanticType": "classification.categories"
      },
      "primary_category_id": {
        "type": "string",
        "required": false,
        "description": "Identifier of the canonical taxonomy node.",
        "semanticType": "classification.primary"
      },
      "primary_category_path": {
        "type": "string",
        "required": false,
        "description": "Human-readable breadcrumb path (Electronics > Mobile > Android)."
      },
      "tags": {
        "type": "Tag[]",
        "required": false,
        "default": [],
        "description": "Canonical tag collection after synonym collapse.",
        "semanticType": "classification.tags"
      },
      "tag_count": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Number of canonical tags assigned to the object."
      },
      "tag_preview": {
        "type": "string",
        "required": false,
        "description": "Denormalized comma-delimited preview for list renders."
      },
      "searchQuery": {
        "type": "string",
        "required": false,
        "default": "",
        "description": "The current search query string entered by the user.",
        "semanticType": "input.search.query"
      },
      "searchActive": {
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "Whether the search input is currently focused or has a non-empty query.",
        "semanticType": "state.search.active"
      },
      "filters": {
        "type": "object[]",
        "required": false,
        "default": [],
        "description": "Array of available filter descriptors. Each entry defines a filterable dimension:\n  - field: string (the schema field to filter on)\n  - label: string (display label)\n  - type: \"select\" | \"multi-select\" | \"range\" | \"boolean\" | \"date-range\"\n  - options: array of { value, label } for select/multi-select types\n",
        "semanticType": "input.filter.descriptors"
      },
      "activeFilters": {
        "type": "object[]",
        "required": false,
        "default": [],
        "description": "Array of currently applied filter values:\n  - field: string (matches a filter descriptor field)\n  - operator: \"eq\" | \"in\" | \"range\" | \"gt\" | \"lt\" | \"between\"\n  - value: unknown (the selected filter value or values)\n",
        "semanticType": "state.filter.active"
      },
      "filterCount": {
        "type": "number",
        "required": true,
        "default": 0,
        "description": "Computed count of currently active filters.",
        "semanticType": "metric.filter.count"
      },
      "page": {
        "type": "number",
        "required": true,
        "default": 1,
        "description": "Current page number (1-based).",
        "semanticType": "state.pagination.page"
      },
      "pageSize": {
        "type": "number",
        "required": true,
        "default": 25,
        "description": "Number of items displayed per page.",
        "semanticType": "state.pagination.pageSize"
      },
      "totalItems": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Total number of items across all pages. Used to compute total page count.",
        "semanticType": "metric.pagination.totalItems"
      },
      "totalPages": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Computed total number of pages (ceil(totalItems / pageSize)).",
        "semanticType": "metric.pagination.totalPages"
      },
      "decision_id": {
        "type": "string",
        "required": true,
        "description": "The record's own identifier. CMOS assigns an integer; the object declares a string so the same shape carries another store's identifiers without coercion.",
        "semanticType": "delivery.decision.id"
      },
      "decision_text": {
        "type": "string",
        "required": true,
        "description": "The decision as it was written. The longest free text this registry carries: 61 to 8,418 characters in the live store, with 197 of 1,933 rows over 2,000, so every context that shows it must stay readable at 390 without hiding meaning.",
        "semanticType": "delivery.decision.text"
      },
      "sprint_id": {
        "type": "string",
        "required": false,
        "description": "The sprint the decision was taken in. Every non-null value in the live store resolves against a sprint, none dangling.",
        "semanticType": "delivery.decision.sprint_id"
      },
      "mission_id": {
        "type": "string",
        "required": false,
        "description": "The mission that captured it, as CMOS stores it. Recorded loosely — often a bare \"m02\" rather than a fully qualified \"s203-m02\" — so it is shown as a label and never as a resolved link.",
        "semanticType": "delivery.decision.mission_id"
      },
      "session_id": {
        "type": "string",
        "required": false,
        "description": "The session that recorded the decision. Null on 838 of 1,933 rows.",
        "semanticType": "delivery.decision.session_id"
      },
      "project_id": {
        "type": "string",
        "required": true,
        "description": "The project the decision belongs to. A slug such as \"forge\", never a uuid.",
        "semanticType": "delivery.decision.project_id"
      },
      "project_domain": {
        "type": "string",
        "required": false,
        "description": "Optional area within the project. Sparse — null on 1,850 of 1,933 rows.",
        "semanticType": "delivery.decision.project_domain"
      },
      "evidence": {
        "type": "object[]",
        "required": false,
        "description": "What the decision cites, as {type, id} references. Sparse (null on 1,923 rows) but real, and the rows a preview shows beside a design.",
        "semanticType": "delivery.decision.evidence"
      }
    }
  },
