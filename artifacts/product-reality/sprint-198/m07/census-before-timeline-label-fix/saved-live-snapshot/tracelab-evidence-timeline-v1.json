          "type": "stack",
          "gapToken": "cluster-default"
        },
        "children": [
          {
            "id": "timeline-header-1",
            "component": "Stack",
            "layout": {
              "type": "inline",
              "align": "space-between"
            },
            "style": {
              "spacingToken": "inset-default"
