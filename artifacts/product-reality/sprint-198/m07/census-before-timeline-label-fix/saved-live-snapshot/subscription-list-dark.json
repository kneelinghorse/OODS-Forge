    "objectSchema": {
      "status": {
        "type": "string",
        "required": true,
        "description": "Current lifecycle status of the subscription.",
        "enum": [
          "future",
          "trialing",
          "active",
          "paused",
          "pending_cancellation",
          "delinquent",
          "terminated"
        ],
        "semanticType": "billing.subscription.status"
      },
      "state_history": {
        "type": "StateTransition[]",
        "required": false,
        "description": "Chronological log of state transitions. Each entry records the before/after states,\ntimestamp, and (when governance is enabled) the actor, reason, and transition metadata.\nRendered by StatusTimeline in the detail and timeline views.\n\nEntry structure:\n  - from: string (previous state)\n  - to: string (new state)\n  - timestamp: ISO 8601 datetime\n  - actor_id: string (user/system who triggered the transition, optional)\n  - reason: string (human-readable justification, required when requireTransitionReason is true)\n  - transition_metadata: Record<string, unknown> (arbitrary context, optional)\n",
        "semanticType": "timeline.state_transition"
      },
      "allowed_transitions": {
        "type": "string[]",
        "required": false,
        "description": "Materialized list of valid next states from the current status, computed from the\ntransitionRules parameter. When transitionRules is null (open model), this contains\nall states except the current one. Used by StatusSelector to disable invalid options\nand by StatusBadge to indicate available paths.\n",
        "semanticType": "status.navigation"
      },
      "cancel_at_period_end": {
        "type": "boolean",
        "required": true,
        "description": "Whether the subscription will cancel at the natural billing period end.",
        "semanticType": "billing.subscription.cancel_at_period_end"
      },
      "cancellation_reason": {
        "type": "string",
        "required": false,
        "description": "Free-form explanation captured during cancellation workflows.",
        "semanticType": "billing.subscription.cancellation_reason"
      },
      "cancellation_reason_code": {
        "type": "string",
        "required": false,
        "description": "Structured reason code chosen from the allowedReasons parameter.",
        "semanticType": "status.cancel.reason_code"
      },
      "cancellation_requested_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp when cancellation was initiated.",
        "semanticType": "billing.subscription.cancellation_requested_at"
      },
      "created_at": {
        "type": "datetime",
        "required": true,
        "description": "Timestamp recording when the entity was first created.",
        "semanticType": "audit.created_at"
      },
      "updated_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the most recent modification, when available.",
        "semanticType": "audit.updated_at"
      },
      "last_event": {
        "type": "string",
        "required": true,
        "description": "Lifecycle event associated with the most recent timestamp mutation.",
        "semanticType": "audit.event.type"
      },
      "last_event_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the lifecycle event captured in last_event.",
        "semanticType": "audit.event.timestamp"
      },
      "amount": {
        "type": "integer",
        "required": true,
        "description": "Recurring price expressed in minor units (e.g., cents).",
        "semanticType": "billing.plan.amount"
      },
      "currency": {
        "type": "string",
        "required": true,
        "description": "ISO 4217 currency code used for billing.",
        "semanticType": "billing.plan.currency"
      },
      "billing_interval": {
        "type": "string",
        "required": false,
        "description": "Recurrence cadence (monthly, yearly, quarterly, etc.).",
        "semanticType": "billing.subscription.interval"
      },
      "payment_status": {
        "type": "string",
        "required": false,
        "description": "Outcome of the most recent collection attempt. Distinct from subscription\nlifecycle status — a subscription can be \"active\" with payment_status \"retrying\".\n",
        "enum": [
          "pending",
          "succeeded",
          "failed",
          "retrying",
          "refunded"
        ],
        "semanticType": "billing.cycle.payment_status"
      },
      "payment_method_type": {
        "type": "string",
        "required": false,
        "description": "Payment instrument category used for collection.",
        "enum": [
          "card",
          "ach",
          "wire",
          "invoice",
          "other"
        ],
        "semanticType": "billing.cycle.payment_method"
      },
      "proration_amount": {
        "type": "integer",
        "required": false,
        "description": "Prorated credit or charge in minor currency units generated by a mid-cycle\nplan change. Positive values are charges; negative values are credits.\nOnly populated when the supportProration parameter is true.\n",
        "semanticType": "billing.cycle.proration"
      },
      "last_payment_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp of the most recent successful payment.",
        "semanticType": "billing.subscription.last_payment_at"
      },
      "next_payment_due_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp when the next payment attempt should occur.",
        "semanticType": "billing.subscription.next_payment_due_at"
      },
      "current_period_start": {
        "type": "datetime",
        "required": true,
        "description": "Start timestamp of the current billing cycle.",
        "semanticType": "billing.subscription.current_period_start"
      },
      "current_period_end": {
        "type": "datetime",
        "required": true,
        "description": "End timestamp of the current billing cycle.",
        "semanticType": "billing.subscription.current_period_end"
      },
      "current_period_progress": {
        "type": "number",
        "required": false,
        "description": "Decimal progress (0-1) through the active billing cycle.",
        "semanticType": "billing.subscription.current_period_progress"
      },
      "subscription_id": {
        "type": "string",
        "required": true,
        "description": "Primary identifier used across billing and lifecycle systems.",
        "semanticType": "billing.subscription.id"
      },
      "plan_name": {
        "type": "string",
        "required": true,
        "description": "Human-readable plan label shown in headers.",
        "semanticType": "billing.plan.name"
      },
      "plan_code": {
        "type": "string",
        "required": false,
        "description": "Internal plan code or price identifier.",
        "semanticType": "billing.plan.code"
      },
      "plan_interval": {
        "type": "string",
        "required": false,
        "description": "Billing interval descriptor (monthly, yearly, etc.).",
        "semanticType": "billing.plan.interval"
      },
      "customer_name": {
        "type": "string",
        "required": false,
        "description": "Customer or account name associated with the subscription.",
        "semanticType": "customer.account.name"
      },
      "customer_email": {
        "type": "email",
        "required": false,
        "description": "Billing contact email address.",
        "semanticType": "customer.account.email"
      }
    }
  },
  "object": "Subscription",
