+      "name": "Statusable",
+      "version": "1.0.0",
+      "description": "Semantic status presentation layer that maps business statuses to visual tones,\ndesign tokens, and badge/banner rendering. Statusable owns the status registry\npattern: a domain-scoped lookup table that translates raw status strings into\nconsistent visual output (tone, label, icon, token sets).\n\nDISTINCT from Stateful — Stateful governs state machine transitions and guards;\nStatusable governs how status LOOKS. Statusable is the bridge between data-layer\nstate and the component layer (Badge, Banner, StatusBadge).\n\nCore concepts:\n- Status Registry: Map<domain, Map<status, StatusPresentation>>\n- Tone System: Six semantic tones (neutral, info, accent, success, warning, critical)\n- Token Resolution: --cmp-status-{tone}-{surface|border|text} CSS variables\n- Domain Scoping: Each domain (subscription, invoice, ticket, etc.) has its own status map\n- Emphasis Variants: badge.subtle / badge.solid, banner.subtle / banner.solid",
+      "category": "visual",
+      "tags": [
+        "status",
+        "presentation",
+        "registry",
+        "badge",
+        "banner",
+        "tone",
+        "semantic",
+        "saas"
+      ],
+      "contexts": [
+        "detail",
+        "form",
+        "list",
+        "timeline"
+      ],
+      "viewExtensions": [
+        {
+          "component": "Badge",
+          "context": "list",
+          "position": "after",
+          "priority": null,
+          "props": {
+            "statusField": "status",
+            "domainField": "domain",
+            "emphasis": "subtle",
+            "showIcon": true
+          }
+        },
+        {
+          "component": "StatusBadge",
+          "context": "detail",
+          "position": "main",
+          "priority": 80,
+          "props": {
+            "statusField": "status",
+            "domainField": "domain",
+            "emphasis": "subtle",
+            "showIcon": true
+          }
+        },
+        {
+          "component": "Banner",
+          "context": "detail",
+          "position": "top",
+          "priority": 90,
+          "props": {
+            "statusField": "status",
+            "domainField": "domain",
+            "emphasis": "subtle",
+            "showIcon": true
+          }
+        },
+        {
+          "component": "StatusBadge",
+          "context": "form",
+          "position": "top",
+          "priority": null,
+          "props": {
+            "statusField": "status",
+            "domainField": "domain",
+            "emphasis": "subtle",
+            "readOnly": true
+          }
+        },
+        {
+          "component": "StatusBadge",
+          "context": "timeline",
+          "position": null,
+          "priority": null,
+          "props": {
+            "statusField": "status",
+            "domainField": "domain",
+            "emphasis": "subtle",
+            "showIcon": true,
+            "compact": true
+          }
+        }
+      ],
+      "parameters": [
+        {
+          "name": "domains",
+          "type": "string[]",
+          "required": true,
+          "description": "Domain identifiers whose statuses this object participates in.\nEach domain resolves to a scoped status map in the registry\n(e.g., \"subscription\", \"invoice\", \"ticket\", \"user\").\n",
+          "default": [
+            "subscription"
+          ]
+        },
+        {
+          "name": "toneAliases",
+          "type": "Record<string, StatusTone>",
+          "required": false,
+          "description": "Custom alias map for inferring tones from token path segments.\nMerged with built-in aliases (info, positive→success, danger→critical, etc.).\nKeys are token path segments; values are canonical StatusTone values.\n",
+          "default": {}
+        },
+        {
+          "name": "defaultTone",
+          "type": "StatusTone",
+          "required": false,
+          "description": "Fallback tone applied when a status is not found in the registry\nor when tone inference from token paths yields no match.\n",
+          "default": "neutral",
+          "validation": {
+            "enum": [
+              "neutral",
+              "info",
+              "accent",
+              "success",
+              "warning",
+              "critical"
+            ]
+          }
+        }
+      ],
+      "schema": {
+        "status": {
+          "type": "string",
+          "required": true,
+          "description": "Raw business status string (e.g., \"active\", \"past_due\", \"unpaid\").\nResolved against the domain's status map to derive presentation data.\n"
+        },
+        "domain": {
+          "type": "StatusDomain",
+          "required": true,
+          "description": "Domain scope for registry lookup. Determines which status map is consulted\n(e.g., \"subscription\" statuses differ from \"invoice\" statuses).\n",
+          "validation": {
+            "enumFromParameter": "domains"
+          }
+        },
+        "tone": {
+          "type": "StatusTone",
+          "required": false,
+          "description": "Semantic tone derived from the registry or inferred from token paths.\nOne of: neutral, info, accent, success, warning, critical.\nFalls back to the defaultTone parameter when unresolvable.\n",
+          "validation": {
+            "enum": [
+              "neutral",
+              "info",
+              "accent",
+              "success",
+              "warning",
+              "critical"
+            ]
+          }
+        },
+        "badge_tokens": {
+          "type": "StatusTokenVariants",
+          "required": false,
+          "description": "Resolved badge token sets with subtle and solid emphasis variants.\nEach variant contains { background, border, foreground } CSS variable references.\nStructure: { subtle: StatusTokenSet, solid: StatusTokenSet }\n"
+        },
+        "banner_tokens": {
+          "type": "StatusTokenVariants",
+          "required": false,
+          "description": "Resolved banner token sets with subtle and solid emphasis variants.\nSubtle banners use domain-specific tokens when available; solid banners\nuse the tone-based component token set.\nStructure: { subtle: StatusTokenSet, solid: StatusTokenSet }\n"
+        }
+      },
+      "semantics": {
+        "status": {
+          "semantic_type": "status.presentation.status",
+          "token_mapping": "tokenMap(status.registry.*)",
+          "ui_hints": {
+            "component": "StatusBadge",
+            "registryLookup": "getStatusPresentation(domain, status)"
+          }
+        },
+        "domain": {
+          "semantic_type": "status.presentation.domain",
+          "token_mapping": "tokenMap(status.domains.*)",
+          "ui_hints": {
+            "component": "DomainSelector",
+            "scopedTo": "domains"
+          }
+        },
+        "tone": {
+          "semantic_type": "status.presentation.tone",
+          "token_mapping": "tokenMap(status.tone.*)",
+          "ui_hints": {
+            "component": "ToneBadge",
+            "toneValues": [
+              "neutral",
+              "info",
+              "accent",
+              "success",
+              "warning",
+              "critical"
+            ]
+          }
+        },
+        "badge_tokens": {
+          "semantic_type": "status.presentation.badge",
+          "token_mapping": "tokenMap(cmp.status.{tone}.*)",
+          "ui_hints": {
+            "component": "Badge",
+            "emphasisVariants": [
+              "subtle",
+              "solid"
+            ]
+          }
+        },
+        "banner_tokens": {
+          "semantic_type": "status.presentation.banner",
+          "token_mapping": "tokenMap(cmp.status.{tone}.*)",
+          "ui_hints": {
+            "component": "Banner",
+            "emphasisVariants": [
+              "subtle",
+              "solid"
+            ]
+          }
+        }
+      },
+      "tokens": {
+        "cmp.status.neutral.surface": "var(--sys-surface-neutral)",
+        "cmp.status.neutral.border": "var(--sys-border-neutral)",
+        "cmp.status.neutral.text": "var(--sys-text-neutral)",
+        "cmp.status.info.surface": "var(--sys-surface-info)",
+        "cmp.status.info.border": "var(--sys-border-info)",
+        "cmp.status.info.text": "var(--sys-text-info)",
+        "cmp.status.accent.surface": "var(--sys-surface-accent)",
+        "cmp.status.accent.border": "var(--sys-border-accent)",
+        "cmp.status.accent.text": "var(--sys-text-accent)",
+        "cmp.status.success.surface": "var(--sys-surface-success)",
+        "cmp.status.success.border": "var(--sys-border-success)",
+        "cmp.status.success.text": "var(--sys-text-success)",
+        "cmp.status.warning.surface": "var(--sys-surface-warning)",
+        "cmp.status.warning.border": "var(--sys-border-warning)",
+        "cmp.status.warning.text": "var(--sys-text-warning)",
+        "cmp.status.critical.surface": "var(--sys-surface-critical)",
+        "cmp.status.critical.border": "var(--sys-border-critical)",
+        "cmp.status.critical.text": "var(--sys-text-critical)",
+        "cmp.banner.background": "var(--sys-surface-raised)",
+        "cmp.banner.border": "var(--sys-border-default)",
+        "cmp.banner.text": "var(--sys-text-default)"
+      },
+      "dependencies": [],
+      "metadata": {
+        "created": "2026-02-28",
+        "owners": [
+          "design@oods.systems",
+          "engineering@oods.systems"
+        ],
+        "maturity": "experimental",
+        "accessibility": {
+          "keyboard": "Badge and Banner elements are not interactive; no keyboard handling required.",
+          "screenreader": "StatusBadge announces status label and tone as a live region.\nBanner uses role=\"status\" with aria-live=\"polite\" for critical/warning tones.\n"
+        },
+        "regionsUsed": [
