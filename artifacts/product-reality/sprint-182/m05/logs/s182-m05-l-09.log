+def _find_matching_story_token(
+    tokens: List[Tuple[str, str]],
+    start: int,
+    opening: str,
+    closing: str,
+) -> Optional[int]:
+    if start >= len(tokens) or tokens[start][1] != opening:
+        return None
+    depth = 0
+    for index in range(start, len(tokens)):
+        value = tokens[index][1]
+        if value == opening:
+            depth += 1
+        elif value == closing:
+            depth -= 1
+            if depth == 0:
