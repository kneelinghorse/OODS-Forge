+        "maturity": "stable",
+        "accessibility": {
+          "keyboard": "SearchInput supports full keyboard navigation:\n- Type to enter search query\n- Escape to clear the search input\n- Tab to move focus out of the search input\n",
+          "screenreader": "Search input is labelled with role=\"search\" and an accessible name.\nCurrent query state is announced via aria-live region on debounce completion.\nClear button is announced as \"Clear search\".\n"
+        },
+        "regionsUsed": [
+          "list",
