+  block-size: 2.5rem;
+  align-items: center;
+  justify-content: center;
+  align-self: start;
+  padding: 0;
+  border: 1px solid currentColor;
+  border-radius: var(--cmp-button-radius, 0.5rem);
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  cursor: pointer;
+}
+
+:where(.oods-checkbox, [data-oods-component='Checkbox']) {
+  display: inline-grid;
+  grid-template-columns: auto 1fr;
+  align-items: start;
+  gap: var(--cmp-checkbox-gap, 0.5rem);
+  color: var(--cmp-checkbox-text, var(--cmp-text-body, CanvasText));
+}
+
+:where(.oods-checkbox input, [data-oods-component='Checkbox']) {
+  accent-color: var(--cmp-checkbox-background-checked, Highlight);
+}
+
+:where(.oods-grid, [data-oods-component='Grid']) {
+  display: grid;
+  grid-template-columns: repeat(var(--oods-grid-columns, auto-fit), minmax(min(100%, var(--oods-grid-min-column, 16rem)), 1fr));
+  gap: var(--oods-layout-gap, var(--cmp-spacing-stack-default, 1rem));
+  align-items: var(--oods-layout-align, stretch);
+  justify-content: var(--oods-layout-justify, normal);
+}
+
+:where(.oods-stack, [data-oods-component='Stack']) {
+  display: flex;
+  flex-direction: var(--oods-stack-direction, column);
+  flex-wrap: var(--oods-stack-wrap, nowrap);
+  gap: var(--oods-layout-gap, var(--cmp-spacing-stack-default, 1rem));
+  align-items: var(--oods-layout-align, stretch);
+  justify-content: var(--oods-layout-justify, flex-start);
+}
+
+:where(.oods-table, [data-oods-component='Table']) {
+  inline-size: 100%;
+  border-collapse: collapse;
+  background: var(--cmp-surface-panel, Canvas);
+  color: var(--cmp-text-body, CanvasText);
+}
+
+:where(.oods-table, [data-oods-component='Table'])[data-density='compact'] {
+  --oods-table-cell-padding-block: var(--sys-space-inset-compact, 0.5rem);
+  --oods-table-cell-padding-inline: var(--sys-space-inline-sm, 0.875rem);
+  font-size: var(--sys-text-size-sm, 0.875rem);
+}
+
+:where(.oods-table, [data-oods-component='Table'])[data-density='default'],
+:where(.oods-table, [data-oods-component='Table'])[data-density='comfortable'] {
+  --oods-table-cell-padding-block: 0.75rem;
+  --oods-table-cell-padding-inline: var(--sys-space-inset-default, 1.5rem);
+  font-size: var(--sys-text-size-md, 1rem);
+}
+
+:where(.oods-table, [data-oods-component='Table']) :is(th, td) {
+  padding: var(--oods-table-cell-padding-block, var(--cmp-spacing-inset-compact, 0.75rem))
+    var(--oods-table-cell-padding-inline, var(--cmp-spacing-inset-default, 1rem));
+  border-block-end: 1px solid var(--cmp-border-default, currentColor);
+  text-align: start;
+}
+
+:where(.oods-tabs, [data-oods-component='Tabs']) {
+  --oods-tabs-font-size: var(--sys-text-size-md, 1rem);
+  --oods-tabs-padding-block: 0.625rem;
+  --oods-tabs-padding-inline: 0.75rem;
+  color: var(--cmp-text-body, CanvasText);
+}
+
+:where(.oods-tabs, [data-oods-component='Tabs'])[data-size='sm'] {
+  --oods-tabs-font-size: var(--sys-text-size-sm, 0.875rem);
+  --oods-tabs-padding-block: 0.5rem;
+  --oods-tabs-padding-inline: 0.625rem;
+}
+
+:where(.oods-tabs, [data-oods-component='Tabs'])[data-size='md'] {
+  --oods-tabs-font-size: var(--sys-text-size-md, 1rem);
+  --oods-tabs-padding-block: 0.625rem;
+  --oods-tabs-padding-inline: 0.75rem;
+}
+
+:where(.oods-tabs, [data-oods-component='Tabs'])[data-size='lg'] {
+  --oods-tabs-font-size: var(--sys-text-size-lg, 1.25rem);
+  --oods-tabs-padding-block: 0.75rem;
+  --oods-tabs-padding-inline: 1rem;
+}
+
+.oods-tab-list { display: flex; gap: var(--cmp-spacing-inline-xs, 0.5rem); overflow-x: auto; border-block-end: 1px solid var(--cmp-border-default, currentColor); }
+.oods-tab { padding: var(--oods-tabs-padding-block) var(--oods-tabs-padding-inline); border: 0; border-block-end: 0.1875rem solid transparent; background: transparent; color: inherit; font: inherit; font-size: var(--oods-tabs-font-size); line-height: var(--sys-text-line-height-standard, 1.4); }
+:where(.oods-tabs-overflow-trigger, .tabs__overflow-trigger) { padding: var(--oods-tabs-padding-block) var(--oods-tabs-padding-inline); font: inherit; font-size: var(--oods-tabs-font-size); line-height: var(--sys-text-line-height-standard, 1.4); }
+.oods-tab[aria-selected='true'] { border-block-end-color: var(--cmp-text-accent, Highlight); font-weight: var(--ref-typography-weights-semibold, 600); }
+.oods-tab-panel { padding-block: var(--cmp-spacing-stack-default, 1rem); }
+
+:where(.oods-text, [data-oods-component='Text']) {
+  color: var(--cmp-text-body, CanvasText);
+  font: inherit;
+}
+
+:where(.oods-text, [data-oods-component='Text'])[data-size='sm'] {
+  font-size: var(--sys-text-size-sm, 0.875rem);
+  line-height: var(--sys-text-line-height-relaxed, 1.5);
+}
+
+:where(.oods-text, [data-oods-component='Text'])[data-size='md'] {
+  font-size: var(--sys-text-size-md, 1rem);
+  line-height: var(--sys-text-line-height-relaxed, 1.5);
+}
+
+:where(.oods-text, [data-oods-component='Text'])[data-size='lg'] {
+  font-size: var(--sys-text-size-lg, 1.25rem);
+  line-height: var(--sys-text-line-height-standard, 1.4);
+}
+
+:where(.oods-text, [data-oods-component='Text'])[data-weight='regular'],
+:where(.oods-text, [data-oods-component='Text'])[data-weight='normal'] {
+  font-weight: var(--ref-typography-weights-regular, 400);
+}
+
+:where(.oods-text, [data-oods-component='Text'])[data-weight='medium'] {
+  font-weight: var(--ref-typography-weights-medium, 500);
+}
+
+:where(.oods-text, [data-oods-component='Text'])[data-weight='semibold'] {
+  font-weight: var(--ref-typography-weights-semibold, 600);
+}
+
+@media (max-width: 40rem) {
+  :where(.oods-banner, [data-oods-component='Banner']) { grid-template-columns: 1fr; }
+  :where(.oods-table, [data-oods-component='Table']):not([data-density]) { font-size: 0.875rem; }
+}
+
+@media (forced-colors: active) {
+  :where(.oods-badge, .oods-banner, .oods-button, .oods-card, .oods-field-control, .oods-tab, .oods-table) {
+    forced-color-adjust: none;
+  }
+}
+
+/*
+ * High-contrast brand tokens intentionally flatten status surfaces to Canvas.
+ * Keep their foreground on the matching CanvasText system colour rather than
+ * HighlightText (which is only guaranteed against a Highlight background).
+ */
+[data-theme='hc'] :where(
+  .oods-badge,
+  [data-oods-component='Badge'],
+  .oods-banner,
+  [data-oods-component='Banner']
+) {
+  border-color: Highlight;
+  background: Canvas;
+  color: CanvasText;
+}
+
+[data-theme='hc'] .oods-field-error {
+  color: CanvasText;
+}
+
+[data-theme='hc'] :where(.oods-button, [data-oods-component='Button']):not(:disabled) {
+  border-color: Highlight;
+  background: Highlight;
+  color: HighlightText;
+}
+
+[data-theme='hc'] :where(.oods-button, [data-oods-component='Button']):disabled {
+  border-color: GrayText;
+  background: Canvas;
+  color: GrayText;
+}
+:root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: var(--sys-surface-canvas); }
+* { box-sizing: border-box; }
+body { margin: 0; min-width: 20rem; background: var(--sys-surface-canvas); color: var(--sys-text-primary); }
+#foundation-v1-showcase {
+  width: min(76rem, calc(100% - 2rem)); margin: 0 auto; padding: clamp(1rem, 3vw, 3rem);
+  background: linear-gradient(145deg, var(--sys-surface-panel), var(--sys-surface-canvas));
+}
+#foundation-v1-showcase > * { min-width: 0; max-width: 100%; }
+#showcase-title { max-width: 24ch; letter-spacing: -0.025em; }
+#showcase-profile, #showcase-banner, #showcase-grid, [data-oods-component='Table'], [data-oods-component='Tabs'] {
+  width: 100%;
+}
+#showcase-profile { padding: var(--ref-space-scale-lg); }
+#showcase-grid { padding: var(--ref-space-scale-md); border: 1px solid var(--sys-border-subtle); }
+.oods-table__container { width: 100%; max-width: 100%; min-width: 0; overflow-x: auto; }
+.oods-table { min-width: 0; table-layout: auto; }
+.oods-field { max-width: 42rem; }
+button, input, select, textarea { font: inherit; }
+@media (max-width: 42rem) {
+  #foundation-v1-showcase { width: 100%; padding: 1rem; }
+  #showcase-title { font-size: 1.65rem; }
+}
