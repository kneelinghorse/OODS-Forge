+  { id: 'grid-responsive', oodsComponentId: 'Grid', props: { minColumnWidth: '16rem', gap: 'md', align: 'stretch' }, slots: { default: ['First card', 'Second card'] }, initialState: { columns: 'auto-fit' }, event: { name: 'render', trigger: 'resize across phone and desktop widths', expected: 'content reflows without clipping' }, assertions: ['two children remain visible', 'DOM order is preserved'] },
