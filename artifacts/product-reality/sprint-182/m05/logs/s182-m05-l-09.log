(--sys-text-on-interactive);--cmp-button-text-disabled:var(--sys-text-disabled);--cmp-button-focus-width:var(--sys-focus-width, 2px);--cmp-button-focus-outer:var(--sys-focus-ring-outer, Highlight)\" type=\"button\" id=\"showcase-secondary-action\">Cancel</button><section class=\"oods-card rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-shadow dark:border-slate-800 dark:bg-slate-950 shadow-lg shadow-slate-200/50 dark:shadow-none\" data-oods-component=\"Card\" data-elevated=\"true\" id=\"showcase-profile\"><p class=\"oods-text text-base leading-6 font-normal\" data-oods-component=\"Text\" data-size=\"md\" data-weight=\"regular\" id=\"showcase-profile-copy\">Canonical fields retain their labels, help, and validation state.</p></section><div class=\"oods-field form-field oods-checkbox\" data-density=\"comfortable\"><label class=\"form-field__label\" for=\"marketing\"><input id=\"marketing\" type=\"checkbox\" class=\"form-field__checkbox\" data-oods-component=\"Checkbox\" aria-describedby=\"marketing-description\" required=\"\" checked=\"\"/><span class=\"oods-field-label\">Product updates</span><span class=\"oods-field-required form-field__required-indicator\" aria-hidden=\"true\">*</span></label><p id=\"marketing-description\" class=\"oods-field-help form-field__description\">Choose whether to subscribe.</p></div><div class=\"oods-field form-field\" data-density=\"comfortable\"><label class=\"form-field__label\" for=\"renewal\"><span class=\"oods-field-label\">Renewal date</span></label><div class=\"form-field__control\"><input id=\"renewal\" type=\"date\" class=\"oods-field-control form-field__input form-field__date-picker\" data-oods-component=\"DatePicker\" max=\"2026-12-31\" min=\"2026-09-01\" step=\"1\" value=\"2026-09-30\"/></div></div><div class=\"oods-grid\" data-oods-component=\"Grid\" style=\"--oods-grid-columns:auto-fit;--oods-grid-min-column:14rem;--oods-layout-gap:var(--cmp-spacing-stack-default, 1rem);--oods-layout-align:stretch;--oods-layout-justify:normal\" id=\"showcase-grid\"><strong class=\"oods-text text-base leading-6 font-normal\" data-oods-component=\"Text\" data-size=\"md\" data-weight=\"regular\" id=\"showcase-grid-primary\">Account health</strong><span class=\"oods-text text-base leading-6 font-normal\" data-oods-component=\"Text\" data-size=\"md\" data-weight=\"regular\" id=\"showcase-grid-secondary\">Recent changes</span></div><div class=\"oods-field form-field\" style=\"--cmp-input-message-border:var(--sys-status-critical-border);--cmp-input-message-text:var(--sys-status-critical-text);--form-field-border:var(--sys-status-critical-border);--form-field-border-active:var(--sys-status-critical-border);--form-field-background-active:var(--sys-status-critical-surface);--form-field-validation-color:var(--sys-status-critical-text);--form-field-focus-inner:var(--sys-status-critical-border);--form-field-focus-outer:var(--sys-status-critical-surface);--form-field-accent:var(--sys-status-critical-text)\" data-density=\"comfortable\" data-validation-state=\"error\"><label class=\"form-field__label\" for=\"email\"><span class=\"oods-field-label\">Email</span><span class=\"oods-field-required form-field__required-indicator\" aria-hidden=\"true\">*</span></label><div class=\"form-field__control\"><input id=\"email\" type=\"email\" class=\"oods-field-control form-field__input\" data-oods-component=\"Input\" data-validation-state=\"error\" aria-describedby=\"email-description email-validation\" aria-invalid=\"true\" required=\"\" value=\"invalid\"/></div><p id=\"email-description\" class=\"oods-field-help form-field__description\">Use a work address.</p><p id=\"email-validation\" class=\"oods-field-error form-field__validation\" role=\"alert\" aria-live=\"assertive\" data-state=\"error\">Enter a valid email.</p></div><div class=\"oods-field form-field\" data-density=\"comfortable\"><label class=\"form-field__label\" for=\"plan\"><span class=\"oods-field-label\">Plan</span></label><div class=\"form-field__control\"><select id=\"plan\" class=\"oods-field-control form-field__select\" data-oods-component=\"Select\"><option value=\"basic\">Basic</option><option value=\"pro\" selected=\"\">Pro</option><option value=\"enterprise\">Enterprise</option></select></div></div><div class=\"oods-table__container\" data-density=\"compact\"><table class=\"oods-table\" data-oods-component=\"Table\" data-density=\"compact\" id=\"showcase-subscriptions\"><caption class=\"oods-table__caption\">Subscriptions</caption><thead class=\"oods-table__header\"><tr><th class=\"oods-table__header-cell\" scope=\"col\">Name</th><th class=\"oods-table__header-cell\" scope=\"col\">Plan</th><th class=\"oods-table__header-cell\" scope=\"col\">Status</th></tr></thead><tbody class=\"oods-table__body\"><tr class=\"oods-table__row\" data-selectable=\"true\"><td class=\"oods-table__cell\"><button type=\"button\" class=\"oods-table-row-action\">Northwind</button></td><td class=\"oods-table__cell\">Enterprise</td><td class=\"oods-table__cell\">Active</td></tr><tr class=\"oods-table__row\" data-selectable=\"true\"><td class=\"oods-table__cell\"><button type=\"button\" class=\"oods-table-row-action\">Contoso</button></td><td class=\"oods-table__cell\">Pro</td><td class=\"oods-table__cell\">Past due</td></tr></tbody></table></div><div class=\"oods-tabs tabs\" data-oods-component=\"Tabs\" data-size=\"md\" id=\"showcase-tabs\"><div class=\"oods-tab-list tabs__list\" role=\"tablist\" aria-label=\"Account sections\"><button id=\"_R_d_-tab-overview\" type=\"button\" role=\"tab\" class=\"oods-tab tabs__tab tabs__tab--selected\" data-size=\"md\" data-tab-id=\"overview\" aria-selected=\"true\" aria-controls=\"_R_d_-panel-overview\" tabindex=\"0\" title=\"Overview\"><span class=\"tabs__tab-label\">Overview</span></button><button id=\"_R_d_-tab-billing\" type=\"button\" role=\"tab\" class=\"oods-tab tabs__tab\" data-size=\"md\" data-tab-id=\"billing\" aria-selected=\"false\" aria-controls=\"_R_d_-panel-billing\" tabindex=\"-1\" title=\"Billing\"><span class=\"tabs__tab-label\">Billing</span></button><button id=\"_R_d_-tab-security\" type=\"button\" role=\"tab\" class=\"oods-tab tabs__tab tabs__tab--disabled\" data-size=\"md\" data-tab-id=\"security\" aria-selected=\"false\" aria-controls=\"_R_d_-panel-security\" tabindex=\"-1\" disabled=\"\" title=\"Security\"><span class=\"tabs__tab-label\">Security</span></button></div><div id=\"_R_d_-panel-overview\" role=\"tabpanel\" class=\"oods-tab-panel tabs__panel\" aria-labelledby=\"_R_d_-tab-overview\" tabindex=\"0\">Account health and recent changes.</div><div id=\"_R_d_-panel-billing\" role=\"tabpanel\" class=\"oods-tab-panel tabs__panel\" aria-labelledby=\"_R_d_-tab-billing\" hidden=\"\" tabindex=\"0\"></div><div id=\"_R_d_-panel-security\" role=\"tabpanel\" class=\"oods-tab-panel tabs__panel\" aria-labelledby=\"_R_d_-tab-security\" hidden=\"\" tabindex=\"0\"></div></div><div class=\"oods-field form-field\" data-density=\"comfortable\"><label class=\"form-field__label\" for=\"notes\"><span class=\"oods-field-label\">Notes</span></label><div class=\"form-field__control\"><textarea id=\"notes\" class=\"oods-field-control form-field__input form-field__textarea\" data-oods-component=\"Textarea\" aria-describedby=\"notes-description\" rows=\"4\">Call before renewal.</textarea></div><p id=\"notes-description\" class=\"oods-field-help form-field__description\">Visible to account managers.</p></div></div>"}
