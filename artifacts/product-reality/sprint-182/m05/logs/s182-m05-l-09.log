+  --oods-color-brand-a-surface-inverse: oklch(0.29 0.052 86); /** Inverse surface for tooltips and chips on warm panels. */
+  --oods-color-brand-a-surface-interactive-primary-default: oklch(0.56 0.19 43); /** Primary interactive background. ΔL −0.02 from the s167 value so near-white text.onInteractive clears AA with margin (measured 4.61:1, sRGB-clipped). */
+  --oods-color-brand-a-surface-interactive-primary-hover: oklch(0.52 0.2 43); /** Hover tracks new baseline with ΔL −0.06 / ΔC +0.01 guardrails. */
