+  --oods-color-brand-a-status-critical-surface: oklch(0.9672 0.0163 20.78); /** Critical background tone. */
+  --oods-color-brand-a-status-critical-border: oklch(0.824 0.0834 27.01); /** Critical border tone. */
+  --oods-color-brand-a-status-critical-text: oklch(0.465 0.147 32.94); /** Critical text tone. */
+  --oods-color-brand-a-status-critical-icon: oklch(0.6039 0.1827 32.43); /** Critical icon colour. */
