+      "projectId": "forge",
+      "stableEventId": "01M1H8X44CBD6680KVB6RGYBZE",
+      "occurredAt": 1788359905420,
+      "originSeq": 1320,
+      "eventType": "next_step_created",
+      "schemaVersion": 1,
+      "authorUserId": null,
+      "owner": "Forge",
+      "disposition": "carried-unchanged-not-absorbed"
