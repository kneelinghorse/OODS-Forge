+  --oods-color-brand-a-text-inverse: oklch(0.92 0.02 86); /** Inverse body text for dark overlays. */
+  --oods-color-brand-a-text-accent: oklch(0.495 0.17 45); /** Accent text for inline highlights and links. ΔL −0.025 from the s168 value so the pairing with surface.subtle clears AA — that pairing was ungraded until s169 completed the text × panel grid. No ratio is quoted here on purpose: every text.accent claim is graded against the CANVAS pair, so a number about a different surface would be checked against the wrong one. */
