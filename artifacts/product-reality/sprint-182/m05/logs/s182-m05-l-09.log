+      "name": "Labelled",
+      "version": "2.0.0",
+      "description": "Canonical label, description, and placeholder copy for authored objects.\nLabelled is a foundational content trait used by Organization, Product,\nRelationship, and other core objects to provide consistent text display\nacross all view contexts.\n\nSupports configurable length constraints, required/optional description,\nand copy variants (e.g., primary, short, formal) for context-sensitive\ntext rendering.",
+      "category": "content",
+      "tags": [
+        "label",
+        "description",
+        "copy",
+        "metadata",
+        "content"
+      ],
+      "contexts": [
+        "card",
+        "detail",
+        "form",
+        "inline",
+        "list",
+        "timeline"
+      ],
+      "viewExtensions": [
+        {
+          "component": "LabelCell",
+          "context": "list",
+          "position": null,
+          "priority": 100,
+          "props": {
+            "field": "label",
+            "descriptionField": "description",
+            "truncate": true,
+            "maxLengthParameter": "maxLabelLength"
+          }
+        },
+        {
+          "component": "DetailHeader",
+          "context": "detail",
+          "position": "top",
+          "priority": 100,
+          "props": {
