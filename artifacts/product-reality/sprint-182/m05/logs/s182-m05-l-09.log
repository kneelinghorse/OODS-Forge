+
+:where(.oods-badge, [data-oods-component='Badge']) {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--cmp-badge-gap, 0.25rem);
+  padding: var(--cmp-badge-padding-block, 0.125rem) var(--cmp-badge-padding-inline, 0.5rem);
+  border: 1px solid var(--cmp-badge-border, var(--cmp-border-default, currentColor));
+  border-radius: var(--cmp-badge-radius, 999px);
+  background: var(--cmp-badge-background, var(--cmp-surface-subtle, transparent));
+  color: var(--cmp-badge-text, var(--cmp-text-body, currentColor));
+  font-size: var(--cmp-badge-font-size, 0.875rem);
+  font-weight: var(--cmp-badge-font-weight, 600);
+}
+
+/* Solid reverses the already contrast-checked status surface/text pair. */
+:where(.oods-badge, [data-oods-component='Badge'])[data-emphasis='solid'] {
+  border-color: var(--cmp-badge-text, var(--sys-status-neutral-text, CanvasText));
+  background: var(--cmp-badge-text, var(--sys-status-neutral-text, CanvasText));
+  color: var(--cmp-badge-background, var(--sys-status-neutral-surface, Canvas));
+}
+
+:where(.oods-banner, [data-oods-component='Banner'])[data-emphasis='solid'] {
+  border-color: var(--cmp-banner-text, var(--sys-status-neutral-text, CanvasText));
+  background: var(--cmp-banner-text, var(--sys-status-neutral-text, CanvasText));
+  color: var(--cmp-banner-background, var(--sys-status-neutral-surface, Canvas));
+}
+
+:where(.oods-banner, [data-oods-component='Banner']) {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  gap: var(--cmp-spacing-inline-sm, 0.75rem);
+  padding: var(--cmp-spacing-inset-default, 1rem);
+  border: 1px solid var(--cmp-banner-border, var(--cmp-border-default, currentColor));
+  border-radius: var(--cmp-input-radius, 0.5rem);
+  background: var(--cmp-banner-background, var(--cmp-surface-subtle, transparent));
+  color: var(--cmp-banner-text, var(--cmp-text-body, currentColor));
+}
+
+:where(.oods-button, [data-oods-component='Button']) {
+  display: inline-flex;
+  min-block-size: var(--oods-button-min-block-size, 2.5rem);
+  box-sizing: border-box;
+  align-items: center;
+  justify-content: center;
+  gap: var(--cmp-button-gap, 0.5rem);
+  padding: var(--oods-button-padding-block, var(--cmp-button-padding-block, 0.625rem))
+    var(--oods-button-padding-inline, var(--cmp-button-padding-inline, 1rem));
+  border: 1px solid var(--oods-button-border, var(--cmp-button-border, transparent));
+  border-radius: var(--cmp-button-radius, 0.5rem);
+  background: var(--oods-button-background, var(--cmp-button-background, var(--cmp-surface-action, CanvasText)));
+  color: var(--oods-button-text, var(--cmp-button-text, var(--cmp-text-on-action, Canvas)));
+  font: inherit;
+  font-size: var(--oods-button-font-size, var(--sys-text-size-md, 1rem));
+  font-weight: var(--cmp-button-font-weight, 600);
+  line-height: 1;
+  cursor: pointer;
+}
+
+:where(.oods-button, [data-oods-component='Button'])[data-intent='neutral'] {
+  --oods-button-background: var(--sys-surface-inverse, CanvasText);
+  --oods-button-background-hover: var(--sys-surface-inverse, CanvasText);
+  --oods-button-border: var(--sys-surface-inverse, CanvasText);
+  --oods-button-text: var(--sys-text-inverse, Canvas);
+}
+
+:where(.oods-button, [data-oods-component='Button'])[data-intent='primary'] {
+  --oods-button-background: var(--sys-surface-interactive-primary-default, CanvasText);
+  --oods-button-background-hover: var(--sys-surface-interactive-primary-hover, CanvasText);
+  --oods-button-border: var(--sys-surface-interactive-primary-default, CanvasText);
+  --oods-button-text: var(--sys-text-on-interactive, Canvas);
+}
+
+:where(.oods-button, [data-oods-component='Button'])[data-intent='secondary'] {
+  --oods-button-background: var(--sys-surface-subtle, Canvas);
+  --oods-button-background-hover: var(--sys-surface-canvas, Canvas);
+  --oods-button-border: var(--sys-border-strong, CanvasText);
+  --oods-button-text: var(--sys-text-primary, CanvasText);
+}
+
+:where(.oods-button, [data-oods-component='Button'])[data-intent='success'] {
+  --oods-button-background: var(--sys-status-success-text, CanvasText);
+  --oods-button-background-hover: var(--sys-status-success-text, CanvasText);
+  --oods-button-border: var(--sys-status-success-text, CanvasText);
+  --oods-button-text: var(--sys-status-success-surface, Canvas);
+}
+
+:where(.oods-button, [data-oods-component='Button'])[data-intent='warning'] {
+  --oods-button-background: var(--sys-status-warning-text, CanvasText);
+  --oods-button-background-hover: var(--sys-status-warning-text, CanvasText);
+  --oods-button-border: var(--sys-status-warning-text, CanvasText);
+  --oods-button-text: var(--sys-status-warning-surface, Canvas);
+}
+
+:where(.oods-button, [data-oods-component='Button'])[data-intent='danger'] {
+  --oods-button-background: var(--sys-status-critical-text, CanvasText);
+  --oods-button-background-hover: var(--sys-status-critical-text, CanvasText);
