+    name: str,
+    before: int,
+) -> Optional[int]:
+    candidate: Optional[int] = None
+    for index in range(before - 1):
+        if tokens[index][1] not in {"const", "let", "var"}:
+            continue
+        if tokens[index + 1] != ("identifier", name):
+            continue
+
+        cursor = index + 2
+        while cursor < before and tokens[cursor][1] != ";":
+            if tokens[cursor][1] == "=":
