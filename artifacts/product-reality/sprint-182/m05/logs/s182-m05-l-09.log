+  { id: 'select-controlled', oodsComponentId: 'Select', props: { id: 'plan', label: 'Plan', value: 'pro', options: [{ value: 'basic', label: 'Basic' }, { value: 'pro', label: 'Pro' }] }, slots: {}, initialState: { value: 'pro' }, event: { name: 'change', trigger: 'choose Basic', expected: 'basic emitted once' }, assertions: ['label targets select', 'selected option is visible'] },
