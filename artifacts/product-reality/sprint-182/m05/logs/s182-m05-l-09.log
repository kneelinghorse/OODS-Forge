+  --oods-color-brand-b-surface-canvas: Canvas; /** Forced-colors canvas maps to system Canvas. */
+  --oods-color-brand-b-surface-raised: Canvas; /** Raised surfaces mirror Canvas in HC mode. */
+  --oods-color-brand-b-surface-subtle: Canvas; /** Subtle surfaces flatten to Canvas for predictability. */
+  --oods-color-brand-b-surface-disabled: Canvas; /** Disabled surfaces stay on Canvas to preserve outlines. */
+  --oods-color-brand-b-surface-backdrop: Canvas; /** Backdrop scrims fall back to Canvas in HC mode. */
+  --oods-color-brand-b-surface-inverse: CanvasText; /** Inverse surfaces flip to CanvasText for contrast. */
+  --oods-color-brand-b-surface-interactive-primary-default: Highlight; /** Primary action aligns to Highlight in HC. */
+  --oods-color-brand-b-surface-interactive-primary-hover: Highlight; /** Hover remains Highlight to avoid flicker. */
+  --oods-color-brand-b-surface-interactive-primary-pressed: Highlight; /** Pressed state remains Highlight. */
+  --oods-color-brand-b-border-subtle: CanvasText; /** Default border maps to CanvasText. */
+  --oods-color-brand-b-border-strong: Highlight; /** High-emphasis border uses Highlight for visibility. */
+  --oods-color-brand-b-focus-ring-outer: Highlight; /** High-contrast focus halo uses the system Highlight color. */
+  --oods-color-brand-b-focus-ring-inner: Canvas; /** High-contrast inner focus ring uses the system Canvas color. */
+  --oods-color-brand-b-focus-text: HighlightText; /** High-contrast focus text uses the system HighlightText color. */
+  --oods-color-brand-b-text-primary: CanvasText; /** Primary text uses CanvasText for HC compliance. */
+  --oods-color-brand-b-text-secondary: GrayText; /** Secondary copy falls back to GrayText. */
+  --oods-color-brand-b-text-muted: GrayText; /** Muted copy also maps to GrayText. */
+  --oods-color-brand-b-text-inverse: Canvas; /** Inverse text uses Canvas to contrast CanvasText surfaces. */
+  --oods-color-brand-b-text-accent: LinkText; /** Accent inline text maps to LinkText in HC. */
+  --oods-color-brand-b-text-on-interactive: HighlightText; /** Interactive foreground uses HighlightText. */
+  --oods-color-brand-b-text-disabled: GrayText; /** Disabled text uses GrayText baseline. */
+  --oods-color-brand-b-accent-background: Canvas; /** Accent surfaces resolve to Canvas. */
+  --oods-color-brand-b-accent-border: Highlight; /** Accent border leverages Highlight. */
+  --oods-color-brand-b-accent-text: HighlightText; /** Accent text maps to HighlightText. */
+  --oods-color-brand-b-status-info-surface: Canvas; /** Info backgrounds map to Canvas. */
+  --oods-color-brand-b-status-info-border: Highlight; /** Info borders use Highlight. */
+  --oods-color-brand-b-status-info-text: HighlightText; /** Info text uses HighlightText. */
+  --oods-color-brand-b-status-info-icon: HighlightText; /** Info icon uses HighlightText. */
+  --oods-color-brand-b-status-success-surface: Canvas; /** Success surfaces map to Canvas. */
+  --oods-color-brand-b-status-success-border: Highlight; /** Success border uses Highlight. */
+  --oods-color-brand-b-status-success-text: HighlightText; /** Success text uses HighlightText. */
+  --oods-color-brand-b-status-success-icon: HighlightText; /** Success icon uses HighlightText. */
+  --oods-color-brand-b-status-warning-surface: Canvas; /** Warning surfaces map to Canvas. */
+  --oods-color-brand-b-status-warning-border: Highlight; /** Warning border uses Highlight. */
+  --oods-color-brand-b-status-warning-text: HighlightText; /** Warning text uses HighlightText. */
+  --oods-color-brand-b-status-warning-icon: HighlightText; /** Warning icon uses HighlightText. */
+  --oods-color-brand-b-status-critical-surface: Canvas; /** Critical surfaces flatten to Canvas. */
+  --oods-color-brand-b-status-critical-border: Highlight; /** Critical border uses Highlight. */
+  --oods-color-brand-b-status-critical-text: HighlightText; /** Critical text uses HighlightText. */
+  --oods-color-brand-b-status-critical-icon: HighlightText; /** Critical icon uses HighlightText. */
+  --oods-color-brand-b-status-neutral-surface: Canvas; /** Neutral surface maps to Canvas. */
+  --oods-color-brand-b-status-neutral-border: CanvasText; /** Neutral border uses CanvasText. */
+  --oods-color-brand-b-status-neutral-text: CanvasText; /** Neutral text uses CanvasText. */
+  --oods-color-brand-b-status-neutral-icon: CanvasText; /** Neutral icon uses CanvasText. */
+}
