+    {
+      "id": 1317,
+      "content": "Fix the last stale advertised-count site: docs/how-forge-works.html:379 still says '25-tool roster' (should be 26). Rule 15 membership missed it; every other named 19→20 and 25→26 site moved correctly.",
+      "status": "pending",
+      "sessionId": "PS-2026-09-02-002",
