+const artifactRoot = resolve(repositoryRoot, 'artifacts/product-reality/sprint-182/m03/visual-regression');
+const canonicalIds = [
+  'Badge', 'Banner', 'Button', 'Card', 'Checkbox', 'DatePicker', 'Grid',
+  'Input', 'Select', 'Stack', 'Table', 'Tabs', 'Text', 'Textarea',
