+  --oods-color-brand-a-focus-text: oklch(0.495 0.17 45); /** Branded light focus text matches the Brand A accent text. */
+  --oods-color-brand-a-text-primary: oklch(0.26 0.05 265); /** Primary body copy colour achieving ≥12:1 on canvas. */
+  --oods-color-brand-a-text-secondary: oklch(0.39 0.04 265); /** Secondary text for muted labels and metadata. */
