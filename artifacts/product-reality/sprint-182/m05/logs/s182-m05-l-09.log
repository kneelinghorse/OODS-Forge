+    {
+      "name": "Stateful",
+      "version": "2.0.0",
+      "description": "Normalizes lifecycle state transitions, exposes canonical status semantics, and provides\noptional transition governance for production workflows. Stateful is the most-composed\ntrait in the system (used by 18 objects including User, Subscription, Product, Order)\nand serves as the data source for the Colorized visual trait.\n\nAt its simplest, Stateful defines an ordered list of valid states and tracks the current\nstatus. When governance is enabled via transitionRules, it additionally enforces which\ntransitions are allowed, records the actor and reason for each transition, and materializes\nthe set of valid next states — making it suitable for auditable workflows where arbitrary\nstate jumps are not permitted.",
+      "category": "lifecycle",
+      "tags": [
+        "lifecycle",
+        "status",
+        "workflow",
+        "state",
+        "governance",
+        "audit"
+      ],
+      "contexts": [
+        "card",
+        "detail",
+        "form",
+        "list",
+        "timeline"
+      ],
+      "viewExtensions": [
+        {
+          "component": "StatusBadge",
+          "context": "list",
+          "position": null,
+          "priority": null,
+          "props": {
+            "field": "status",
+            "tone": "lifecycle"
+          }
+        },
+        {
+          "component": "StatusTimeline",
+          "context": "detail",
+          "position": "top",
+          "priority": 40,
+          "props": {
+            "field": "status",
+            "historyField": "state_history",
+            "statesParameter": "states",
+            "showActorId": true,
+            "showReason": true
+          }
+        },
+        {
+          "component": "StatusSelector",
+          "context": "form",
+          "position": "top",
+          "priority": null,
+          "props": {
+            "field": "status",
+            "optionsParameter": "states",
+            "initialParameter": "initialState",
+            "allowedTransitionsField": "allowed_transitions",
+            "requireReasonParameter": "requireTransitionReason"
+          }
+        },
+        {
+          "component": "StateTransitionEvent",
+          "context": "timeline",
+          "position": null,
+          "priority": null,
+          "props": {
+            "historyField": "state_history",
+            "labelField": "status",
+            "showActor": true,
+            "showReason": true
+          }
+        },
+        {
+          "component": "StatusBadge",
+          "context": "card",
+          "position": "before",
+          "priority": null,
+          "props": {
+            "field": "status",
+            "variant": "subtle"
+          }
+        }
+      ],
+      "parameters": [
+        {
+          "name": "states",
+          "type": "string[]",
+          "required": true,
+          "description": "Ordered list of valid lifecycle states exposed to consumers. The order is semantic —\nit represents the typical forward progression (e.g., draft → active → archived).\nAll status values must be one of these states.\n",
+          "default": [
+            "draft",
+            "active",
+            "paused",
+            "archived"
+          ]
+        },
+        {
+          "name": "initialState",
+          "type": "string",
+          "required": true,
+          "description": "State assigned when an entity is created. Must be a member of the states parameter.\nTypically the first entry in the states list (e.g., \"draft\").\n",
+          "default": "draft",
+          "validation": {
+            "enumFromParameter": "states"
+          }
+        },
+        {
+          "name": "transitionRules",
+          "type": "Record<string, string[]>",
+          "required": false,
+          "description": "Allowed state transition map. Keys are source states; values are arrays of permitted\ntarget states. When provided, the system enforces that only declared transitions are\nvalid — any other transition is rejected. When omitted, all transitions between any\ntwo states in the states parameter are allowed (open model).\n\nExample for a subscription lifecycle:\n  draft: [active, archived]\n  active: [paused, archived]\n  paused: [active, archived]\n  archived: []\n",
+          "default": null
+        },
+        {
+          "name": "requireTransitionReason",
+          "type": "boolean",
+          "required": false,
+          "description": "When true, every state transition must include a human-readable reason in the\nstate_history entry. Enforced at the application layer — transitions without a\nreason field are rejected. Useful for compliance and audit trails.\n",
+          "default": false
+        }
+      ],
+      "schema": {
+        "status": {
+          "type": "string",
+          "required": true,
+          "description": "Canonical lifecycle state derived from the states parameter. This is the single source\nof truth for the entity's current lifecycle position. Consumed by Colorized to resolve\nvisual tokens, and by view extensions to render StatusBadge and StatusTimeline.\n",
+          "validation": {
+            "enumFromParameter": "states"
+          }
+        },
+        "state_history": {
+          "type": "StateTransition[]",
+          "required": false,
+          "description": "Chronological log of state transitions. Each entry records the before/after states,\ntimestamp, and (when governance is enabled) the actor, reason, and transition metadata.\nRendered by StatusTimeline in the detail and timeline views.\n\nEntry structure:\n  - from: string (previous state)\n  - to: string (new state)\n  - timestamp: ISO 8601 datetime\n  - actor_id: string (user/system who triggered the transition, optional)\n  - reason: string (human-readable justification, required when requireTransitionReason is true)\n  - transition_metadata: Record<string, unknown> (arbitrary context, optional)\n",
+          "default": []
+        },
+        "allowed_transitions": {
+          "type": "string[]",
+          "required": false,
+          "description": "Materialized list of valid next states from the current status, computed from the\ntransitionRules parameter. When transitionRules is null (open model), this contains\nall states except the current one. Used by StatusSelector to disable invalid options\nand by StatusBadge to indicate available paths.\n",
+          "default": []
+        }
+      },
+      "semantics": {
+        "status": {
+          "semantic_type": "status.state",
+          "token_mapping": "tokenMap(status.state.*)",
+          "ui_hints": {
+            "component": "StatusBadge",
+            "showIcon": true
+          }
+        },
+        "state_history": {
+          "semantic_type": "timeline.state_transition",
+          "token_mapping": "tokenMap(timeline.status.*)",
+          "ui_hints": {
+            "component": "StatusTimeline",
+            "collapseWhenEmpty": true
+          }
+        },
+        "allowed_transitions": {
+          "semantic_type": "status.navigation",
+          "token_mapping": "computed",
+          "ui_hints": {
+            "component": "StatusSelector",
+            "description": "Drives the set of enabled options in the state transition UI."
+          }
+        }
+      },
+      "tokens": {
+        "status.state.default.bg": "var(--status-neutral-bg)",
+        "status.state.default.text": "var(--status-neutral-text)",
+        "status.timeline.connector": "var(--border-subtle)",
+        "status.timeline.node.bg": "var(--sys-surface-raised)",
+        "status.timeline.node.border": "var(--sys-border-default)",
