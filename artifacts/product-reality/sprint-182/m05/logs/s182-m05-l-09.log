+  --oods-color-brand-a-accent-background: oklch(0.9 0.06 45); /** Accent surface for callouts and banners. */
+  --oods-color-brand-a-accent-border: oklch(0.74 0.14 45); /** Accent border used by StatusChip tone=accent. */
+  --oods-color-brand-a-accent-text: oklch(0.5 0.17 45); /** Accent text to complement warm surfaces. */
+  --oods-color-brand-a-status-info-surface: oklch(0.9685 0.0148 268.73); /** Informational background tone. */
+  --oods-color-brand-a-status-info-border: oklch(0.8191 0.0763 268.81); /** Informational border tone. */
+  --oods-color-brand-a-status-info-text: oklch(0.3847 0.1344 271.74); /** Informational text colour. */
+  --oods-color-brand-a-status-info-icon: oklch(0.5466 0.1806 271.48); /** Informational icon colour. */
+  --oods-color-brand-a-status-success-surface: oklch(0.9743 0.0192 159.94); /** Success background tone. */
+  --oods-color-brand-a-status-success-border: oklch(0.8671 0.0772 157.25); /** Success border tone. */
+  --oods-color-brand-a-status-success-text: oklch(0.4315 0.0821 155.04); /** Success text tone. */
