+      "name": "Addressable",
+      "version": "1.0.0",
+      "description": "Canonical multi-role address trait with validation metadata, geocoding, and international formatting hooks.\nProvides a single, reusable capability for billing, shipping, warehouse, and office addresses.",
+      "category": "core",
+      "tags": [
+        "address",
+        "location",
+        "validation",
+        "delivery"
