+      axis: ['--sys-text-primary', '--sys-border-neutral'], grid: ['--sys-border-subtle'], label: ['--sys-text-neutral'],
+      tooltip: ['--sys-surface-canvas', '--sys-text-primary', '--sys-border-neutral'], legend: ['--sys-text-primary', '--sys-text-neutral'],
