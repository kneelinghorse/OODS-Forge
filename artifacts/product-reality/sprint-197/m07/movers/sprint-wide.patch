+  sourceFiles: ramps.map(({ file, beforeSha256, afterSha256 }) => ({ file, beforeSha256, afterSha256 })),
+  changedTokens, goldenFiles, registryScopes, certifiedMatrix: { ...baseline.certifiedMatrix, status: 'remeasure-in-m05' },
