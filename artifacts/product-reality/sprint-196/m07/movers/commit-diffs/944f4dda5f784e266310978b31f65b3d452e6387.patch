+    else if (args[index] === '--root' && args[index + 1]) root = path.resolve(args[++index]!);
+    else throw new Error(`Unknown or incomplete option: ${args[index]}`);
+  }
+  generateComponentDocs({ root, check }).then(result => {
+    if (!result.ok) {
