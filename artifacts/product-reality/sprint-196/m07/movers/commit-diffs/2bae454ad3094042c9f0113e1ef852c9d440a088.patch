+  assert.equal(pass, 17); assert.equal(typed, 2);
+  assert.equal(e2e.calls.outcomes['brand.apply'].code, 'OODS-N020'); assert.equal(e2e.calls.outcomes['design.preview'].code, 'OODS-N019');
