+export function parseAccountingChanges(output) {
+  const text = Buffer.isBuffer(output) ? output.toString('utf8') : output;
+  if (text === '') return [];
+  assert(text.endsWith('\0'), 'Git name-status output must be NUL terminated.');
+  const fields = text.slice(0, -1).split('\0');
+  assert.equal(fields.length % 2, 0, 'Git name-status output has an incomplete record.');
+  const rows = [];
+  for (let index = 0; index < fields.length; index += 2) {
+    const status = fields[index], file = fields[index + 1];
+    assert(/^[ADMTUXB]$/.test(status), `Unexpected --no-renames status: ${status}`);
+    assert(file && !path.posix.isAbsolute(file) && !file.split('/').includes('..'), 'Invalid repository path in Git output.');
+    rows.push({ status, path: file });
+  }
+  return rows;
