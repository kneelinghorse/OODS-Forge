+  async close(): Promise<void> {
+    const child = this.child;
+    if (!child) return;
+    await new Promise<void>((resolve) => {
+      const timeout = setTimeout(() => child.kill('SIGKILL'), 2_000);
+      timeout.unref();
+      child.once('exit', () => { clearTimeout(timeout); resolve(); });
+      child.kill('SIGTERM');
+    });
+  }
+
