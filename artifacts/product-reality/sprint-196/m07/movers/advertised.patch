+  explicit[key] = value;
+}
+if (args.length && (!/^[a-f0-9]{40}$/.test(explicit['--commit'] ?? '') || !/^sha256:[a-f0-9]{64}$/.test(explicit['--structured-data-manifest-hash'] ?? ''))) {
