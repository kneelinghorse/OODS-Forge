    "objectSchema": {
      "label": {
        "type": "string",
        "required": true,
        "description": "Display projection of title; retain the complete source field.",
        "semanticType": "text.label"
      },
      "description": {
        "type": "string",
        "required": false,
        "description": "Supporting description used in detail and card contexts.",
        "semanticType": "text.description"
      },
      "placeholder": {
        "type": "string",
        "required": false,
        "description": "Hint copy surfaced in form fields when the label is empty.",
        "semanticType": "text.placeholder"
      },
      "status": {
        "type": "string",
        "required": true,
        "description": "Canonical research lifecycle. The API remains authoritative; do not coerce an unknown server value.",
        "enum": [
          "draft",
          "final"
        ],
        "semanticType": "status.state"
      },
      "state_history": {
        "type": "StateTransition[]",
        "required": false,
        "default": [],
        "description": "Chronological log of state transitions. Each entry records the before/after states,\ntimestamp, and (when governance is enabled) the actor, reason, and transition metadata.\nRendered by StatusTimeline in the detail and timeline views.\n\nEntry structure:\n  - from: string (previous state)\n  - to: string (new state)\n  - timestamp: ISO 8601 datetime\n  - actor_id: string (user/system who triggered the transition, optional)\n  - reason: string (human-readable justification, required when requireTransitionReason is true)\n  - transition_metadata: Record<string, unknown> (arbitrary context, optional)\n",
        "semanticType": "timeline.state_transition"
      },
      "allowed_transitions": {
        "type": "string[]",
        "required": false,
        "default": [],
        "description": "Materialized list of valid next states from the current status, computed from the\ntransitionRules parameter. When transitionRules is null (open model), this contains\nall states except the current one. Used by StatusSelector to disable invalid options\nand by StatusBadge to indicate available paths.\n",
        "semanticType": "status.navigation"
      },
      "created_at": {
        "type": "datetime",
        "required": true,
        "description": "Created at.",
        "semanticType": "audit.created_at"
      },
      "updated_at": {
        "type": "datetime",
        "required": true,
        "description": "Updated at.",
        "semanticType": "audit.updated_at"
      },
      "last_event": {
        "type": "string",
        "required": false,
        "description": "Only from an explicit event or timestamp projection; absence is unknown, not a fabricated audit event.",
        "semanticType": "audit.event.type"
      },
      "last_event_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the lifecycle event captured in last_event.",
        "semanticType": "audit.event.timestamp"
      },
      "owner_id": {
        "type": "uuid",
        "required": false,
        "description": "Authoritative nullable server owner_id. Not exposed by the current response; unavailable until the API exposes it. Never derive from created_by, user_id, or project owner.",
        "semanticType": "ownership.owner.id"
      },
      "owner_type": {
        "type": "string",
        "required": false,
        "description": "user only when an authoritative owner_id is present.",
        "enum": [
          "user"
        ],
        "semanticType": "ownership.owner.type"
      },
      "ownership_role": {
        "type": "string",
        "required": false,
        "description": "Optional role name describing how the owner governs the entity.",
        "semanticType": "ownership.owner.role"
      },
      "ownership_transferred_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp recording when ownership was last transferred.",
        "semanticType": "ownership.owner.transferred_at"
      },
      "searchQuery": {
        "type": "string",
        "required": false,
        "default": "",
        "description": "The current search query string entered by the user.",
        "semanticType": "input.search.query"
      },
      "searchActive": {
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "Whether the search input is currently focused or has a non-empty query.",
        "semanticType": "state.search.active"
      },
      "filters": {
        "type": "object[]",
        "required": false,
        "default": [],
        "description": "Array of available filter descriptors. Each entry defines a filterable dimension:\n  - field: string (the schema field to filter on)\n  - label: string (display label)\n  - type: \"select\" | \"multi-select\" | \"range\" | \"boolean\" | \"date-range\"\n  - options: array of { value, label } for select/multi-select types\n",
        "semanticType": "input.filter.descriptors"
      },
      "activeFilters": {
        "type": "object[]",
        "required": false,
        "default": [],
        "description": "Array of currently applied filter values:\n  - field: string (matches a filter descriptor field)\n  - operator: \"eq\" | \"in\" | \"range\" | \"gt\" | \"lt\" | \"between\"\n  - value: unknown (the selected filter value or values)\n",
        "semanticType": "state.filter.active"
      },
      "filterCount": {
        "type": "number",
        "required": true,
        "default": 0,
        "description": "Computed count of currently active filters.",
        "semanticType": "metric.filter.count"
      },
      "page": {
        "type": "number",
        "required": true,
        "default": 1,
        "description": "Current page number (1-based).",
        "semanticType": "state.pagination.page"
      },
      "pageSize": {
        "type": "number",
        "required": true,
        "default": 25,
        "description": "Number of items displayed per page.",
        "semanticType": "state.pagination.pageSize"
      },
      "totalItems": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Total number of items across all pages. Used to compute total page count.",
        "semanticType": "metric.pagination.totalItems"
      },
      "totalPages": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Computed total number of pages (ceil(totalItems / pageSize)).",
        "semanticType": "metric.pagination.totalPages"
      },
      "id": {
        "type": "uuid",
        "required": true,
        "description": "Id.",
        "semanticType": "research.report.id"
      },
      "title": {
        "type": "string",
        "required": true,
        "description": "Title.",
        "semanticType": "text.label"
      },
      "content": {
        "type": "string",
        "required": true,
        "description": "Content.",
        "semanticType": "research.report.content"
      },
      "citations": {
        "type": "CitationSchema[]",
        "required": false,
        "description": "Citations.",
        "semanticType": "research.report.citations"
      },
      "tokens_used": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Tokens used.",
        "semanticType": "research.report.tokens_used"
      },
      "project_id": {
        "type": "uuid",
        "required": false,
        "description": "Project id.",
        "semanticType": "research.report.project_id"
      },
      "report_type": {
        "type": "string",
        "required": false,
        "default": "summary",
        "description": "Report type.",
        "semanticType": "research.report.report_type"
      },
      "prompt": {
        "type": "string",
        "required": false,
        "description": "Prompt.",
        "semanticType": "research.report.prompt"
      },
      "chunk_count": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Chunk count.",
        "semanticType": "research.report.chunk_count"
      },
      "sources": {
        "type": "ReportSourceSchema[]",
        "required": false,
        "description": "Sources.",
        "semanticType": "research.report.sources"
      }
    }
