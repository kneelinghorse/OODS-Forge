 </Stack>\n                            <Stack id=\"detail-tabs-9-user_id-read-field\" data-oods-component=\"Stack\">\n                                <Text id=\"detail-tabs-9-user_id-label\" data-oods-component=\"Text\" as=\"strong\" content=\"User id\" />\n                                <Text id=\"detail-tabs-9-user_id-value\" data-oods-component=\"Text\">{{ formatReadOnlyValue(userId, \"uuid\", false) }}</Text>\n                              </Stack>\n                            <Stack id=\"detail-tabs-9-workspace_id-read-field\" data-oods-component=\"Stack\">\n                                <Text id=\"detail-tabs-9-workspace_id-label\" data-oods-component=\"Text\" as=\"strong\" content=\"Workspace id\" />\n                                <Text id=\"detail-tabs-9-workspace_id-value\" data-oods-component=\"Text\">{{ formatReadOnlyValue(workspaceId, \"uuid\", false) }}</Text>\n                              </Stack>\n                            <Stack id=\"detail-tabs-9-project_id-read-field\" data-oods-component=\"Stack\">\n                                <Text id=\"detail-tabs-9-project_id-label\" data-oods-component=\"Text\" as=\"strong\" content=\"Project id\" />\n                                <Text id=\"detail-tabs-9-project_id-value\" data-oods-component=\"Text\">{{ formatReadOnlyValue(projectId, \"uuid\", false) }}</Text>\n                              </Stack>\n                            <Stack id=\"detail-tabs-9-document_count-read-field\" data-oods-component=\"Stack\">\n                                <Text id=\"detail-tabs-9-document_count-label\" data-oods-component=\"Text\" as=\"strong\" content=\"Document count\" />\n                                <Text id=\"detail-tabs-9-document_count-value\" data-oods-component=\"Text\">{{ formatReadOnlyValue(documentCount, \"number\", false) }}</Text>\n                              </Stack>\n                            <Stack id=\"detail-tabs-9-report_count-read-field\" data-oods-component=\"Stack\">\n        