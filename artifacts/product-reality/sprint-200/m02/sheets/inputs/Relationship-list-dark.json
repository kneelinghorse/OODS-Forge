    "objectSchema": {
      "label": {
        "type": "string",
        "required": true,
        "description": "Human-readable display name rendered in primary surfaces.",
        "semanticType": "text.label"
      },
      "description": {
        "type": "string",
        "required": false,
        "description": "Supporting description used in detail and card contexts.",
        "semanticType": "text.description"
      },
      "placeholder": {
        "type": "string",
        "required": false,
        "description": "Hint copy surfaced in form fields when the label is empty.",
        "semanticType": "text.placeholder"
      },
      "status": {
        "type": "string",
        "required": true,
        "description": "Canonical lifecycle state derived from the states parameter. This is the single source\nof truth for the entity's current lifecycle position. Consumed by Colorized to resolve\nvisual tokens, and by view extensions to render StatusBadge and StatusTimeline.\n",
        "enum": [
          "proposed",
          "active",
          "paused",
          "completed",
          "terminated"
        ],
        "semanticType": "status.state"
      },
      "state_history": {
        "type": "StateTransition[]",
        "required": false,
        "default": [],
        "description": "Chronological log of state transitions. Each entry records the before/after states,\ntimestamp, and (when governance is enabled) the actor, reason, and transition metadata.\nRendered by StatusTimeline in the detail and timeline views.\n\nEntry structure:\n  - from: string (previous state)\n  - to: string (new state)\n  - timestamp: ISO 8601 datetime\n  - actor_id: string (user/system who triggered the transition, optional)\n  - reason: string (human-readable justification, required when requireTransitionReason is true)\n  - transition_metadata: Record<string, unknown> (arbitrary context, optional)\n",
        "semanticType": "timeline.state_transition"
      },
      "allowed_transitions": {
        "type": "string[]",
        "required": false,
        "default": [],
        "description": "Materialized list of valid next states from the current status, computed from the\ntransitionRules parameter. When transitionRules is null (open model), this contains\nall states except the current one. Used by StatusSelector to disable invalid options\nand by StatusBadge to indicate available paths.\n",
        "semanticType": "status.navigation"
      },
      "created_at": {
        "type": "datetime",
        "required": true,
        "description": "Timestamp recording when the entity was first created.",
        "semanticType": "audit.created_at"
      },
      "updated_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the most recent modification, when available.",
        "semanticType": "audit.updated_at"
      },
      "last_event": {
        "type": "string",
        "required": true,
        "description": "Lifecycle event associated with the most recent timestamp mutation.",
        "enum": [
          "created",
          "activated",
          "paused",
          "terminated",
          "reactivated"
        ],
        "semanticType": "audit.event.type"
      },
      "last_event_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the lifecycle event captured in last_event.",
        "semanticType": "audit.event.timestamp"
      },
      "owner_id": {
        "type": "string",
        "required": true,
        "description": "Identifier of the owning principal scoped by owner_type.",
        "semanticType": "ownership.owner.id"
      },
      "owner_type": {
        "type": "string",
        "required": true,
        "description": "Categorical owner type sourced from the ownerTypes parameter.",
        "enum": [
          "organization",
          "team",
          "platform"
        ],
        "semanticType": "ownership.owner.type"
      },
      "ownership_role": {
        "type": "string",
        "required": false,
        "description": "Optional role name describing how the owner governs the entity.",
        "semanticType": "ownership.owner.role"
      },
      "ownership_transferred_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp recording when ownership was last transferred.",
        "semanticType": "ownership.owner.transferred_at"
      },
      "tags": {
        "type": "string[]",
        "required": false,
        "default": [],
        "description": "Ordered list of tags assigned to the entity.",
        "semanticType": "taxonomy.tag.collection"
      },
      "tag_count": {
        "type": "number",
        "required": true,
        "default": 0,
        "description": "Computed number of tags assigned to the entity.",
        "semanticType": "metric.collection.count"
      },
      "tag_metadata": {
        "type": "object[]",
        "required": false,
        "default": [],
        "description": "Per-tag governance metadata. Each entry corresponds to a tag in the tags array and\ntracks provenance and usage for taxonomy health monitoring.\n\nEntry structure:\n  - tag: string (the tag value, matches entry in tags array)\n  - created_at: ISO 8601 datetime\n  - created_by: string (user ID or \"system\" for allow-list tags)\n  - usage_count: number (how many entities use this tag, computed)\n  - moderation_status: \"approved\" | \"pending\" | \"rejected\" (when allowTagModeration is true)\n  - canonical_form: string (resolved synonym target, when synonymResolution is enabled)\n",
        "semanticType": "taxonomy.tag.governance"
      },
      "neighborhood": {
        "type": "array",
        "required": false,
        "description": "Edge records sharing an endpoint with this relationship, each containing source_id and target_id strings and an is_bidirectional boolean. Generated sample rows are explicitly synthetic."
      },
      "relationship_id": {
        "type": "uuid",
        "required": true,
        "description": "Primary identifier for the relationship edge.",
        "semanticType": "graph.relationship.id"
      },
      "source_id": {
        "type": "uuid",
        "required": true,
        "description": "Identifier of the source node in the relationship."
      },
      "target_id": {
        "type": "uuid",
        "required": true,
        "description": "Identifier of the target node in the relationship."
      },
      "relationship_type": {
        "type": "string",
        "required": true,
        "description": "Semantic type describing the edge between the source and target.",
        "enum": [
          "membership",
          "ownership",
          "follows",
          "depends_on",
          "references"
        ],
        "semanticType": "graph.relationship.type"
      },
      "direction": {
        "type": "string",
        "required": true,
        "default": "bidirectional",
        "description": "Directionality applied when traversing the relationship.",
        "enum": [
          "unidirectional",
          "bidirectional"
        ],
        "semanticType": "graph.relationship.direction"
      },
      "strength": {
        "type": "string",
        "required": false,
        "description": "Signal representing how strongly the entities are connected.",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "semanticType": "graph.relationship.strength"
      },
      "origin_source": {
        "type": "string",
        "required": false,
        "description": "System that originated or inferred the relationship.",
        "enum": [
          "manual",
          "ingestion",
          "analytics",
          "integration"
        ],
        "semanticType": "graph.relationship.origin"
      },
      "is_bidirectional": {
        "type": "boolean",
        "required": true,
        "default": true,
        "description": "Flag indicating whether the relationship is symmetric."
      }
    }
  },
