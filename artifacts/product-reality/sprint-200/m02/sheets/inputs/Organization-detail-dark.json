    "objectSchema": {
      "label": {
        "type": "string",
        "required": true,
        "description": "Human-readable display name rendered in primary surfaces.",
        "semanticType": "text.label"
      },
      "description": {
        "type": "string",
        "required": false,
        "description": "Supporting description used in detail and card contexts.",
        "semanticType": "text.description"
      },
      "placeholder": {
        "type": "string",
        "required": false,
        "description": "Hint copy surfaced in form fields when the label is empty.",
        "semanticType": "text.placeholder"
      },
      "status": {
        "type": "string",
        "required": true,
        "description": "Canonical lifecycle state derived from the states parameter. This is the single source\nof truth for the entity's current lifecycle position. Consumed by Colorized to resolve\nvisual tokens, and by view extensions to render StatusBadge and StatusTimeline.\n",
        "enum": [
          "prospect",
          "onboarding",
          "active",
          "churned"
        ],
        "semanticType": "status.state"
      },
      "state_history": {
        "type": "StateTransition[]",
        "required": false,
        "default": [],
        "description": "Chronological log of state transitions. Each entry records the before/after states,\ntimestamp, and (when governance is enabled) the actor, reason, and transition metadata.\nRendered by StatusTimeline in the detail and timeline views.\n\nEntry structure:\n  - from: string (previous state)\n  - to: string (new state)\n  - timestamp: ISO 8601 datetime\n  - actor_id: string (user/system who triggered the transition, optional)\n  - reason: string (human-readable justification, required when requireTransitionReason is true)\n  - transition_metadata: Record<string, unknown> (arbitrary context, optional)\n",
        "semanticType": "timeline.state_transition"
      },
      "allowed_transitions": {
        "type": "string[]",
        "required": false,
        "default": [],
        "description": "Materialized list of valid next states from the current status, computed from the\ntransitionRules parameter. When transitionRules is null (open model), this contains\nall states except the current one. Used by StatusSelector to disable invalid options\nand by StatusBadge to indicate available paths.\n",
        "semanticType": "status.navigation"
      },
      "owner_id": {
        "type": "string",
        "required": true,
        "description": "Identifier of the owning principal scoped by owner_type.",
        "semanticType": "ownership.owner.id"
      },
      "owner_type": {
        "type": "string",
        "required": true,
        "description": "Categorical owner type sourced from the ownerTypes parameter.",
        "enum": [
          "parent_organization",
          "reseller",
          "platform"
        ],
        "semanticType": "ownership.owner.type"
      },
      "ownership_role": {
        "type": "string",
        "required": false,
        "description": "Optional role name describing how the owner governs the entity.",
        "semanticType": "ownership.owner.role"
      },
      "ownership_transferred_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp recording when ownership was last transferred.",
        "semanticType": "ownership.owner.transferred_at"
      },
      "created_at": {
        "type": "datetime",
        "required": true,
        "description": "Timestamp recording when the entity was first created.",
        "semanticType": "audit.created_at"
      },
      "updated_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the most recent modification, when available.",
        "semanticType": "audit.updated_at"
      },
      "last_event": {
        "type": "string",
        "required": true,
        "description": "Lifecycle event associated with the most recent timestamp mutation.",
        "enum": [
          "created",
          "plan_upgraded",
          "plan_downgraded",
          "ownership_transferred"
        ],
        "semanticType": "audit.event.type"
      },
      "last_event_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the lifecycle event captured in last_event.",
        "semanticType": "audit.event.timestamp"
      },
      "tags": {
        "type": "string[]",
        "required": false,
        "default": [],
        "description": "Ordered list of tags assigned to the entity.",
        "semanticType": "taxonomy.tag.collection"
      },
      "tag_count": {
        "type": "number",
        "required": true,
        "default": 0,
        "description": "Computed number of tags assigned to the entity.",
        "semanticType": "metric.collection.count"
      },
      "tag_metadata": {
        "type": "object[]",
        "required": false,
        "default": [],
        "description": "Per-tag governance metadata. Each entry corresponds to a tag in the tags array and\ntracks provenance and usage for taxonomy health monitoring.\n\nEntry structure:\n  - tag: string (the tag value, matches entry in tags array)\n  - created_at: ISO 8601 datetime\n  - created_by: string (user ID or \"system\" for allow-list tags)\n  - usage_count: number (how many entities use this tag, computed)\n  - moderation_status: \"approved\" | \"pending\" | \"rejected\" (when allowTagModeration is true)\n  - canonical_form: string (resolved synonym target, when synonymResolution is enabled)\n",
        "semanticType": "taxonomy.tag.governance"
      },
      "address_roles": {
        "type": "string[]",
        "required": true,
        "default": [],
        "description": "Ordered list of roles that currently have address entries.",
        "semanticType": "location.address.roles"
      },
      "default_address_role": {
        "type": "string",
        "required": false,
        "description": "Role surfaced in UI contexts when one address must be highlighted.",
        "enum": [
          "headquarters",
          "office",
          "warehouse",
          "branch"
        ],
        "semanticType": "location.address.default_role"
      },
      "addresses": {
        "type": "AddressableEntry[]",
        "required": false,
        "default": [],
        "description": "Collection of { role, address, metadata } entries keyed by role.",
        "semanticType": "location.address.collection"
      },
      "preference_document": {
        "type": "PreferenceDocument",
        "required": true,
        "default": {
          "version": "1.0.0",
          "preferences": {
            "theme": {
              "mode": "system"
            },
            "notifications": {
              "mention": {
                "email": true,
                "push": true
              }
            }
          },
          "metadata": {
            "schemaVersion": "1.0.0",
            "lastUpdated": "2025-11-18T00:00:00Z",
            "source": "system",
            "migrationApplied": []
          }
        },
        "description": "Normalized preference payload captured by PreferenceStore (version, preferences map, metadata).",
        "semanticType": "preferences.document"
      },
      "preference_metadata": {
        "type": "PreferenceMetadata",
        "required": true,
        "description": "Tracks schema version, lastUpdated timestamp, migration records, and source.",
        "semanticType": "preferences.metadata"
      },
      "preference_version": {
        "type": "string",
        "required": true,
        "default": "2.0.0",
        "description": "SemVer mirror of preference_document.version for indexing and analytics.",
        "semanticType": "preferences.version"
      },
      "preference_namespaces": {
        "type": "string[]",
        "required": true,
        "default": [
          "notifications",
          "display",
          "privacy"
        ],
        "description": "Materialized namespace list resolved from parameters/registry for auditing.",
        "semanticType": "preferences.namespaces"
      },
      "preference_mutations": {
        "type": "number",
        "required": false,
        "default": 0,
        "description": "Monotonic counter incremented whenever preferences mutate (invalidates caches)."
      },
      "role_catalog": {
        "type": "AuthzRoleDocument[]",
        "required": true,
        "default": [],
        "examples": [
          [
            {
              "id": "11111111-1111-4111-8111-111111111111",
              "name": "Owner",
              "description": "Full tenant access + invoice approval (R21.2 Table 1)."
            },
            {
              "id": "22222222-2222-4222-8222-222222222222",
              "name": "Approver",
              "description": "Workflow approver for compliance-sensitive documents."
            },
            {
              "id": "33333333-3333-4333-8333-333333333333",
              "name": "Editor",
              "description": "Contributor allowed to create + update documents in scope."
            }
          ]
        ],
        "description": "Canonical RBAC roles (R21.2 Part 4.2 TABLE 1).",
        "semanticType": "authorization.roles"
      },
      "permission_catalog": {
        "type": "AuthzPermissionDocument[]",
        "required": true,
        "default": [],
        "description": "Atomic permissions following resource:action notation (TABLE 2).",
        "semanticType": "authorization.permissions"
      },
      "role_permissions": {
        "type": "Record<string, string[]>",
        "required": true,
        "default": {},
        "description": "Junction map for role→permission edges (TABLE 3)."
      },
      "membership_records": {
        "type": "AuthzMembershipDocument[]",
        "required": true,
        "default": [],
        "description": "SaaS membership triple (user_id, organization_id, role_id) with UNIQUE constraint (TABLE 4).",
        "semanticType": "authorization.memberships"
      },
      "role_hierarchy_edges": {
        "type": "AuthzRoleHierarchyEdge[]",
        "required": false,
        "default": [],
        "description": "Parent→child adjacency list for hierarchical RBAC (Part 3.1)."
      },
      "session_roles": {
        "type": "string[]",
        "required": false,
        "default": [],
        "description": "Materialized roles granted within the current session/token exchange."
      },
      "channel_catalog": {
        "type": "Channel[]",
        "required": true,
        "default": [],
        "examples": [
          [
            {
              "id": "44444444-dddd-4ddd-8ddd-dddddddddddd",
              "name": "Primary Email (SMTP)",
              "type": "email"
            },
            {
              "id": "55555555-eeee-4eee-8eee-eeeeeeeeeeee",
              "name": "Twilio SMS",
              "type": "sms"
            },
            {
              "id": "66666666-ffff-4fff-8fff-ffffffffffff",
              "name": "FCM Push",
              "type": "push"
            },
            {
              "id": "77777777-0000-4000-8000-000000000000",
              "name": "Realtime In-App",
              "type": "in_app"
