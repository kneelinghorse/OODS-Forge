{
  "name": "fresh-Usage-list",
  "schemaRef": "sha256:538e55a202923e4b5d3f8c2f19a97c11d9f865d93aad9e6d4f979df55a2d88bb",
  "schema": {
    "version": "2026.02",
    "screens": [
      {
        "id": "screen-list-9",
        "component": "Stack",
        "layout": {
          "type": "stack",
          "gapToken": "cluster-default"
        },
        "children": [
          {
            "id": "list-toolbar-4",
            "component": "Stack",
            "layout": {
              "type": "inline",
              "align": "space-between"
            },
            "style": {
              "spacingToken": "inset-default"
            },
            "children": [
              {
                "id": "slot-search-1",
                "component": "SearchInput",
                "meta": {
                  "intent": "slot:search",
                  "label": "search",
                  "confidence": 1,
                  "confidenceLevel": "low"
                }
              },
              {
                "id": "slot-filters-2",
                "component": "Input",
                "meta": {
                  "intent": "slot:filters",
                  "label": "filters",
                  "confidence": 0.67,
                  "confidenceLevel": "low"
                },
                "props": {
                  "type": "number",
                  "field": "consumed_quantity",
                  "label": "Actual quantity consumed in the active period.",
                  "placeholder": "Enter consumed quantity"
                },
                "bindings": {
                  "onChange": "handleChange_consumed_quantity"
                }
              },
              {
                "id": "slot-toolbar-actions-3",
                "component": "Button",
                "meta": {
                  "intent": "slot:toolbar-actions",
                  "label": "toolbar-actions",
                  "confidence": 1,
                  "confidenceLevel": "low"
                }
              }
            ]
          },
          {
            "id": "list-items-5",
            "component": "Stack",
            "layout": {
              "type": "stack",
              "gapToken": "cluster-tight"
            },
            "children": [
              {
                "id": "slot-items-6",
                "component": "RelativeTimestamp",
                "meta": {
                  "intent": "slot:items",
                  "label": "items"
                },
                "props": {
                  "field": "updated_at",
                  "fallbackField": "created_at",
                  "timezoneParameter": "timezone",
                  "label": "Timestamp for the most recent modification, when available."
                }
              }
            ]
          },
          {
            "id": "list-pagination-7",
            "component": "Stack",
            "layout": {
              "type": "inline",
              "align": "center"
            },
            "style": {
              "spacingToken": "inset-default"
            },
            "children": [
              {
                "id": "slot-pagination-8",
                "component": "PaginationBar",
                "meta": {
                  "intent": "slot:pagination",
                  "label": "pagination",
                  "confidence": 0.77,
                  "confidenceLevel": "low"
                }
              }
            ]
          }
        ],
        "bindings": {
          "onRowClick": "handleRowClick",
          "onSort": "handleSort",
          "onFilter": "handleFilter"
        }
      }
    ],
    "objectSchema": {
      "meter_name": {
        "type": "string",
        "required": true,
        "description": "Friendly metered feature name shown in UI (ex: Analytics Seats).",
        "semanticType": "billing.usage.meter_name"
      },
      "included_quantity": {
        "type": "integer",
        "required": true,
        "description": "Quantity included in base plan before overages.",
        "semanticType": "billing.usage.included_quantity"
      },
      "consumed_quantity": {
        "type": "integer",
        "required": true,
        "description": "Actual quantity consumed in the active period.",
        "semanticType": "billing.usage.consumed_quantity"
      },
      "unit_label": {
        "type": "string",
        "required": true,
        "description": "Label for display, defaults to the unit parameter.",
        "semanticType": "billing.usage.unit_label"
      },
      "period_start": {
        "type": "date",
        "required": true,
        "description": "Date the usage accumulation window began.",
        "semanticType": "billing.usage.period_start"
      },
      "period_end": {
        "type": "date",
        "required": true,
        "description": "Date the usage accumulation window ends.",
        "semanticType": "billing.usage.period_end"
      },
      "rollover_strategy": {
        "type": "string",
        "required": false,
        "description": "Strategy for unused units (inherits rolloverStrategy parameter).",
        "semanticType": "billing.usage.rollover_strategy"
      },
      "overage_rate_minor": {
        "type": "integer",
        "required": false,
        "description": "Cost per additional unit expressed in minor currency units.",
        "semanticType": "billing.usage.overage_rate_minor"
      },
      "projected_overage_minor": {
        "type": "integer",
        "required": false,
        "description": "Forecasted overage spend derived from consumption trends.",
        "semanticType": "billing.usage.projected_overage_minor"
      },
      "samples": {
        "type": "UsageSample[]",
        "required": false,
        "description": "Rolling usage measurements for charts or anomaly detection.",
        "semanticType": "billing.usage.samples"
      },
      "created_at": {
        "type": "datetime",
        "required": true,
        "description": "Timestamp recording when the entity was first created.",
        "semanticType": "audit.created_at"
      },
      "updated_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the most recent modification, when available.",
        "semanticType": "audit.updated_at"
      },
      "last_event": {
        "type": "string",
        "required": true,
        "description": "Lifecycle event associated with the most recent timestamp mutation.",
        "semanticType": "audit.event.type"
      },
      "last_event_at": {
        "type": "datetime",
        "required": false,
        "description": "Timestamp for the lifecycle event captured in last_event.",
        "semanticType": "audit.event.timestamp"
      },
      "usage_id": {
        "type": "string",
        "required": true,
        "description": "Identifier for this usage record.",
        "semanticType": "billing.usage.id"
      },
      "subscription_id": {
        "type": "string",
        "required": true,
        "description": "Subscription the usage belongs to.",
        "semanticType": "billing.usage.subscription_id"
      },
      "meter_id": {
        "type": "string",
        "required": true,
        "description": "Provider specific meter identifier.",
        "semanticType": "billing.usage.meter_id"
      },
      "provider": {
        "type": "string",
        "required": true,
        "description": "Source provider for usage data.",
        "semanticType": "billing.usage.provider"
      },
      "status": {
        "type": "string",
        "required": false,
        "description": "Health of the usage feed (ok, delayed, investigating).",
        "enum": [
          "ok",
          "delayed",
          "investigating"
        ],
        "semanticType": "billing.usage.status"
      },
      "trend_percent": {
        "type": "number",
        "required": false,
        "description": "Percent delta compared to previous window.",
        "semanticType": "billing.usage.trend_percent"
      },
      "variance_minor": {
        "type": "integer",
        "required": false,
        "description": "Currency impact of usage variance calculated with overage rate.",
        "semanticType": "billing.usage.variance_minor"
      },
      "last_reported_at": {
        "type": "datetime",
        "required": true,
        "description": "Timestamp of the most recent provider usage payload.",
        "semanticType": "billing.usage.last_reported_at"
      },
      "anomalies": {
        "type": "UsageAnomaly[]",
        "required": false,
        "description": "Detected anomalies with context for investigation.",
        "semanticType": "billing.usage.anomalies"
      }
    }
  },
  "composition": {
    "handler": "design.compose",
    "input": {
      "object": "Usage",
      "context": "list"
    },
