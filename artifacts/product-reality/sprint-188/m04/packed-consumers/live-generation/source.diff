+.oods-billing-summary {
+  display: inline-block;
+  color: var(--cmp-billing-amount-text, var(--sys-text-strong));
+  font-variant-numeric: tabular-nums;
+}
+.oods-billing-field {
+  display: grid;
+  gap: var(--space-2);
+  min-width: 0;
+  color: var(--cmp-billing-amount-text, var(--sys-text-strong));
+}
+.oods-billing-field > span {
+  color: var(--cmp-billing-currency-text, var(--sys-text-subtle));
+}
+.oods-billing-field > input,
+.oods-billing-field > select {
+  width: 100%;
+  min-width: 0;
+  box-sizing: border-box;
+  padding: var(--space-2) var(--space-3);
+  font: inherit;
+  color: inherit;
+  background: var(--sys-surface-default);
+  border: 1px solid var(--sys-border-default);
+  border-radius: var(--radius-md);
+}
+.oods-billing-field > select {
+  color: var(--cmp-billing-interval-text, var(--sys-text-subtle));
+}
+.oods-billing-field > :focus-visible {
+  outline: 2px solid var(--sys-focus-ring);
+  outline-offset: 2px;
+}
+.oods-billing-field > [aria-invalid='true'] {
+  border-color: var(--sys-status-critical-border);
+}
+.oods-billing-field > [role='alert'] {
+  color: var(--sys-status-critical-text);
+  margin: 0;
+}
