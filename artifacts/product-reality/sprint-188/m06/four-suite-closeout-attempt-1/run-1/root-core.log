+ /**
+  * brand A · theme base — brand namespace
+  */
+ [data-brand='A'][data-theme='base'],
+ [data-brand='A'][data-theme='light'] {
+   --oods-color-brand-a-surface-canvas: oklch(0.967 0.03 86); /** Primary shell background with a warm Brand A tint. */
+   --oods-color-brand-a-surface-raised: oklch(0.935 0.037 86); /** Raised card surface separating panels with subtle warmth. */
+   --oods-color-brand-a-surface-subtle: oklch(0.893 0.048 86); /** Secondary panel surface tuned for AA contrast with primary text. */
+   --oods-color-brand-a-surface-disabled: oklch(0.886 0.03 86); /** Disabled surface. Measured 1.76:1 against text.disabled (sRGB-clipped) — deliberately below 3:1, because WCAG 1.4.3 exempts inactive components and the low contrast IS the disabled affordance. */
+   --oods-color-brand-a-surface-backdrop: oklch(0.368 0.042 86); /** Overlay scrim aligned to Brand A neutrals. */
