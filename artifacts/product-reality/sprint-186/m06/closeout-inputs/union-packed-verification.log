node -e 'const fs=require('"'"'fs'"'"'),assert=require('"'"'node:assert/strict'"'"');const base='"'"'artifacts/product-reality/sprint-186/m06/'"'"';const union=JSON.parse(fs.readFileSync(base+'"'"'union-fold.json'"'"'));const types=fs.readFileSync('"'"'packages/component-contracts/src/types.ts'"'"','"'"'utf8'"'"');const ids=[...types.match(/export const NUCLEUS_COMPONENT_IDS = \[([\s\S]*?)\] as const/)[1].matchAll(/'"'"'([^'"'"']+)'"'"'/g)].map(m=>m[1]);assert.deepEqual(union.nucleusComponents,ids);assert.equal(ids.length,50);assert.equal(new Set(ids).size,50);assert.equal(union.formerPortedComponents.length,8);assert(union.formerPortedComponents.every(id=>ids.includes(id)));assert.equal(union.aliasHorizon,'"'"'sprint-187'"'"');for(const reader of union.readers){assert(fs.existsSync(reader.path));assert(reader.disposition.length>0)}for(const framework of ['"'"'react'"'"','"'"'vue'"'"']){const p=JSON.parse(fs.readFileSync(union.packedConsumers[framework]));const proof=p.proof??p.packedProof;assert.equal(p.status,'"'"'passed'"'"');assert.equal(p.strictCompatibilityCompile.status,'"'"'passed'"'"');assert.equal(p.strictCompatibilityCompile.skipLibCheck,false);assert.deepEqual(proof.compatibilityProof.map(x=>x.componentId).sort(),[...union.formerPortedComponents].sort());for(const row of proof.compatibilityProof){assert(row.esmSame&&row.cjsSame&&row.ssrSame);assert.equal(row.rootMarkup,row.aliasMarkup);assert(row.rootMarkup.includes('"'"'data-oods-component="'"'"'+row.componentId+'"'"'"'"'"'))}assert.equal(proof.compatibilitySpecifiers.root,proof.compatibilitySpecifiers.alias);assert.deepEqual(proof.compatibilityResolution,{runtimeSame:true,readinessSame:true,cssSame:true});const spec='"'"'@oods/components-'"'"'+framework;assert.equal(proof.resolvedSpecifiers[spec],proof.resolvedSpecifiers[spec+'"'"'/ported'"'"']);assert.equal(proof.resolvedSpecifiers['"'"'@oods/component-styles/css'"'"'],proof.resolvedSpecifiers['"'"'@oods/component-styles/css-ported'"'"']);}console.log