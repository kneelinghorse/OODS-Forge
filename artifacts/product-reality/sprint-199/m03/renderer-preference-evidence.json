  {
    "id": "pattern:viz:detail-overview-bar",
    "preferredRenderer": "echarts",
    "layout": {
      "trait": "LayoutConcat",
      "direction": "horizontal",
      "gap": 16,
      "sections": [
        {
          "id": "overview",
          "title": "All products"
        },
        {
          "id": "detail-core",
          "title": "Core detail",
          "filters": [
            {
              "field": "product",
              "operator": "==",
              "value": "Core"
            }
          ]
        },
        {
          "id": "detail-plus",
          "title": "Plus detail",
          "filters": [
            {
              "field": "product",
              "operator": "==",
              "value": "Plus"
