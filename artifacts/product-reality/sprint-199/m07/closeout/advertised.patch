+      "version": "1.0.0",
+      "description": "Adds lifecycle-aware cancellation workflows with policy guardrails and semantic token mappings.",
+      "category": "lifecycle",
+      "tags": [
+        "lifecycle",
+        "cancellation",
+        "retention",
+        "workflow"
