+        {
+          "name": "allowedTags",
+          "type": "string[]",
+          "required": false,
+          "description": "Curated allow list of permitted tags. Behavior depends on allowCustomTags:\n- allowCustomTags=false: Only these tags are permitted (strict mode).\n- allowCustomTags=true: These tags appear as suggestions in TagInput autocomplete.\n",
