+    {
+      "name": "Colorized",
+      "version": "2.0.0",
+      "description": "Maps lifecycle states to semantic color tokens for consistent status theming across the\ndesign system. Colorized is the visual bridge between the Stateful trait's data model and\nthe OODS token system's three-tier architecture (ref → theme → system → component).\n\nEvery object that composes Stateful should also compose Colorized so that status values\nresolve to a deterministic set of surface, border, text, and icon tokens. The trait\nencodes WCAG contrast enforcement, color-blind safety via redundant icon+text cues,\nand theme-aware OKLCH token resolution — ensuring status communication never relies\non color alone.",
+      "category": "visual",
+      "tags": [
+        "color",
+        "semantic",
+        "status",
+        "theming",
+        "accessibility",
+        "oklch",
+        "tokens"
+      ],
+      "contexts": [
+        "card",
+        "detail",
+        "form",
+        "list"
+      ],
+      "viewExtensions": [
+        {
+          "component": "ColorSwatch",
+          "context": "list",
+          "position": null,
+          "priority": null,
+          "props": {
+            "field": "color_state",
+            "size": "sm"
+          }
+        },
+        {
+          "component": "StatusColorLegend",
+          "context": "detail",
+          "position": "top",
+          "priority": null,
+          "props": {
+            "parameter": "colorStates",
+            "badgeField": "color_state",
+            "showTokenReferences": true
+          }
+        },
+        {
+          "component": "ColorStatePicker",
+          "context": "form",
+          "position": "top",
+          "priority": null,
+          "props": {
+            "parameter": "colorStates",
+            "field": "color_state"
+          }
+        },
+        {
+          "component": "ColorizedBadge",
+          "context": "card",
+          "position": "before",
+          "priority": null,
+          "props": {
+            "field": "color_state",
+            "tone": "status",
+            "showIcon": true
+          }
+        }
+      ],
+      "parameters": [
+        {
+          "name": "colorStates",
+          "type": "string[]",
+          "required": true,
+          "description": "Semantic tone keys that define the palette of status colors available to this object.\nEach key maps to a --cmp-status-{tone}-{surface|border|text|icon} token set.\nMust be a subset of the canonical tones defined in the status token layer.\n",
+          "default": [
+            "neutral",
+            "info",
+            "success",
+            "warning",
+            "critical"
+          ],
+          "validation": {
+            "items": {
+              "enum": [
+                "neutral",
+                "info",
+                "accent",
+                "success",
+                "warning",
+                "critical"
+              ]
+            }
+          }
+        },
+        {
+          "name": "contrastLevel",
+          "type": "string",
+          "required": false,
+          "description": "WCAG contrast compliance target for all color pairings produced by this trait.\nAA requires 4.5:1 for normal text and 3:1 for large text / UI components.\nAAA requires 7:1 for normal text and 4.5:1 for large text.\nEnforced at build time by pnpm tokens:guardrails (OKLCH delta-L >= 10, delta-C <= 0.04).\n",
+          "default": "AA",
+          "validation": {
+            "enum": [
+              "AA",
+              "AAA"
+            ]
+          }
+        },
+        {
+          "name": "colorMode",
+          "type": "string",
+          "required": false,
+          "description": "Controls how color_state values resolve to tokens.\n- semantic: Tones map to the system status token layer (--sys-status-{tone}-*).\n  This is the default and recommended mode for most objects.\n- custom: Tones map to object-specific component tokens (--cmp-{object}-status-{tone}-*).\n  Use when an object needs domain-specific color semantics (e.g., billing severity).\n",
+          "default": "semantic",
+          "validation": {
+            "enum": [
+              "semantic",
+              "custom"
+            ]
+          }
+        },
+        {
+          "name": "fallbackTone",
+          "type": "string",
+          "required": false,
+          "description": "Tone applied when a status value cannot be resolved to a known color state.\nPrevents rendering blank or unstyled badges when status data is missing or unknown.\n",
+          "default": "neutral",
+          "validation": {
+            "enum": [
+              "neutral",
+              "info",
+              "accent",
+              "success",
+              "warning",
+              "critical"
+            ]
+          }
+        }
+      ],
+      "schema": {
+        "color_state": {
+          "type": "string",
+          "required": true,
+          "description": "Active semantic tone key derived from the object's current Stateful status.\nResolved at runtime by the statusRegistry via tone inference from token references.\nMust be one of the values defined in the colorStates parameter.\n",
+          "validation": {
+            "enumFromParameter": "colorStates"
+          }
+        },
+        "resolved_token_set": {
+          "type": "object",
+          "required": false,
+          "computed": true,
+          "description": "Materialized CSS custom property map for the active color_state. Populated at render\ntime by the statusRegistry (src/components/statusables/statusRegistry.ts).\nContains surface, border, text, and optional icon token references.\n",
+          "properties": {
+            "surface": {
+              "type": "string",
+              "description": "Background token, e.g. var(--cmp-status-success-surface)"
+            },
+            "border": {
+              "type": "string",
+              "description": "Border token, e.g. var(--cmp-status-success-border)"
+            },
+            "text": {
+              "type": "string",
+              "description": "Foreground text token, e.g. var(--cmp-status-success-text)"
+            },
+            "icon": {
+              "type": "string",
+              "description": "Optional icon color token, e.g. var(--cmp-status-success-icon)"
+            }
+          }
+        },
+        "accessibility_label": {
+          "type": "string",
+          "required": false,
+          "computed": true,
+          "description": "Human-readable status label announced by screen readers. Generated from the\ncolor_state value via toLabel() (e.g., \"past_due\" → \"Past Due\"). Ensures status\nmeaning is communicated without reliance on color perception.\n"
+        }
+      },
+      "semantics": {
+        "color_state": {
+          "semantic_type": "status.visual",
+          "token_mapping": "tokenMap(status.state.*)",
+          "ui_hints": {
+            "component": "ColorTokenBadge",
+            "parameterSource": "colorStates"
+          }
+        },
+        "resolved_token_set": {
+          "semantic_type": "status.visual.tokens",
+          "token_mapping": "computed",
+          "ui_hints": {
+            "component": "internal",
+            "description": "Consumed by StatusBadge and ColorizedBadge at render time."
+          }
+        }
+      },
+      "tokens": {
+        "status.state.badge.radius": "var(--radius-md)",
+        "status.state.badge.gap": "var(--space-1)",
+        "status.state.badge.icon.size": "var(--size-2)",
+        "cmp-status-neutral-surface": "var(--sys-status-neutral-surface)",
+        "cmp-status-neutral-border": "var(--sys-status-neutral-border)",
+        "cmp-status-neutral-text": "var(--sys-status-neutral-text)",
+        "cmp-status-neutral-icon": "var(--sys-status-neutral-icon)",
+        "cmp-status-info-surface": "var(--sys-status-info-surface)",
+        "cmp-status-info-border": "var(--sys-status-info-border)",
+        "cmp-status-info-text": "var(--sys-status-info-text)",
+        "cmp-status-info-icon": "var(--sys-status-info-icon)",
+        "cmp-status-accent-surface": "var(--sys-status-accent-surface)",
+        "cmp-status-accent-border": "var(--sys-status-accent-border)",
+        "cmp-status-accent-text": "var(--sys-status-accent-text)",
+        "cmp-status-accent-icon": "var(--sys-status-accent-icon)",
+        "cmp-status-success-surface": "var(--sys-status-success-surface)",
+        "cmp-status-success-border": "var(--sys-status-success-border)",
+        "cmp-status-success-text": "var(--sys-status-success-text)",
+        "cmp-status-success-icon": "var(--sys-status-success-icon)",
+        "cmp-status-warning-surface": "var(--sys-status-warning-surface)",
+        "cmp-status-warning-border": "var(--sys-status-warning-border)",
+        "cmp-status-warning-text": "var(--sys-status-warning-text)",
+        "cmp-status-warning-icon": "var(--sys-status-warning-icon)",
+        "cmp-status-critical-surface": "var(--sys-status-critical-surface)",
+        "cmp-status-critical-border": "var(--sys-status-critical-border)",
+        "cmp-status-critical-text": "var(--sys-status-critical-text)",
+        "cmp-status-critical-icon": "var(--sys-status-critical-icon)",
+        "cmp-banner-background": "var(--sys-surface-neutral)",
+        "cmp-banner-border": "var(--sys-border-neutral)",
+        "cmp-banner-text": "var(--sys-text-neutral)"
+      },
+      "dependencies": [
+        "Stateful"
+      ],
+      "metadata": {
+        "created": "2025-10-12",
+        "updated": "2026-02-28",
+        "owners": [
+          "design@oods.systems",
+          "engineering@oods.systems"
+        ],
+        "maturity": "stable",
+        "accessibility": {
+          "keyboard": "n/a — Colorized is a visual presentation trait with no interactive elements.",
+          "screenreader": "StatusBadge announces the accessibility_label (human-readable status) and tone.\nColor is never the sole channel for status information.\n",
+          "colorBlind": "All status badges MUST include both an icon and text label alongside the color indicator.\nThis icon+text redundancy requirement ensures that deuteranopia, protanopia, and\ntritanopia users can distinguish statuses without relying on hue perception.\nThe fallbackTone parameter provides a safe default when tone inference fails.\n",
+          "contrastEnforcement": "WCAG compliance is enforced at two levels:\n  1. Build-time: pnpm tokens:guardrails checks OKLCH delta-L >= 10 and delta-C <= 0.04\n     for all interactive state transitions (hover, focus, active).\n  2. Design-time: All text-on-surface pairings in the status token layer meet the\n     contrast ratio specified by the contrastLevel parameter (4.5:1 for AA, 7:1 for AAA).\nDark theme tokens (themes/dark/status.json) use direct OKLCH values tuned to maintain\nthese ratios against dark surfaces.\n"
+        },
+        "regionsUsed": [
+          "badges",
+          "forms",
+          "detail",
+          "card"
+        ],
+        "examples": [
+          "Incident",
+          "Release",
+          "Subscription",
+          "Invoice"
+        ],
+        "stateToToneMapping": {
+          "description": "Canonical mapping from domain status strings to semantic tones, as implemented\nin statusRegistry.ts TOKEN_TONE_ALIASES. Objects may define additional aliases\nin their domain-specific status-map JSON files.\n",
+          "mappings": [
