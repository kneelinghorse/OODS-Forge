+    ),
+  },
+};
+
+const ROW_ALIASES = {
+  "CI-01": ["CI-01"],
+  "CI-02": ["CI-02"],
+  "CI-03": ["CI-03"],
+  "CI-04": ["CI-04"],
+  "CI-05": ["CI-05"],
+  "CI-06": ["CI-06"],
+  "CI-07": ["CI-07"],
+  "CI-08": ["CI-08"],
+  "CI-09": ["CI-09"],
+  "CI-10": ["CI-10"],
+  "CI-11": ["CI-11"],
+  "CI-12": ["CI-12-setup", "L-07-scale"],
+  "CI-13": ["CI-13"],
+  "CI-14": ["CI-14-setup", "L-07-soak"],
+  "CI-15": ["CI-15"],
