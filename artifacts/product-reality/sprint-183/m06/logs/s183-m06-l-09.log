+function validateL09Inspection(
+  repositoryRoot,
+  inspectionReference,
+  record,
+  capture,
+  attributionReference,
+) {
+  assert(
+    inspectionReference?.path === `${OUTPUT_ROOT}/l09-review.json`,
+    "L-09 review path is not canonical.",
