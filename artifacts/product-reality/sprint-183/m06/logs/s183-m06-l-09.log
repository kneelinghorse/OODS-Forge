+    })).toEqual([]);
+    expect(messages('Textarea', {
+      id: 'notes',
+      label: 'Notes',
+      rows: 4,
+    })).toEqual([]);
+  });
+
+  it('validates nested option, table, tab, and field-validation shapes', () => {
+    expect(messages('Select', {
+      id: 'plan',
+      label: 'Plan',
+      options: [{ value: 'pro', label: 'Pro', disabled: false }],
