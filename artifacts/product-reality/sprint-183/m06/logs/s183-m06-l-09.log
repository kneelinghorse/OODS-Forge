+        initialFirstTabSelected: null,
+        initialFirstPanelHidden: null,
+        firstTabSelectedAfter: null,
+        firstPanelHiddenAfter: null,
+        secondTabSelectedAfter: null,
+        secondPanelHiddenAfter: null,
