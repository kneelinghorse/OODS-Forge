{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oods.systems/schemas/traits/mark-bar",
  "title": "MarkBar Trait Parameters",
  "type": "object",
  "properties": {
    "orientation": {
      "type": "string",
      "description": "Axis orientation used for laying out bar rectangles.",
      "enum": [
        "vertical",
        "horizontal"
      ],
      "default": "vertical"
    },
    "bandPadding": {
      "type": "number",
      "description": "Fractional padding between category bands (0-0.5).",
      "minimum": 0,
      "maximum": 0.5,
      "default": 0.1
    },
    "cornerRadius": {
      "type": "number",
      "description": "Pixel radius applied to bar corners.",
      "minimum": 0,
      "maximum": 12,
      "default": 2
    },
    "stacking": {
      "type": "string",
      "description": "Aggregation strategy when multiple series share the mark.",
      "enum": [
        "auto",
        "normalize",
        "none"
      ],
      "default": "auto"
    },
    "renderIntent": {
      "type": "string",
      "description": "JSON-encoded Cartesian viz.render input fragment for the governed authoring recipes. Data rows remain a consumer operand.",
      "default": "{}"
    },
    "previewSvg": {
      "type": "string",
      "description": "Static SVG returned by viz.render for the authored sample; omitted until a chart is rendered."
    },
    "chart": {
      "title": "ChartDeclaration",
      "description": "Read-only chart rendered by public viz.render during code generation. Payment events retain the Subscription projection. Record-array charts bind a declared object array and use authored sampleRows to seed generated sample records, with no separate generated chart series. Static SVG assets are keyed by seed record identity; consumers can replace the typed svg prop. One distinct chart declaration is supported per generated object; repeated identical projections share the same asset.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chartType",
            "source",
            "dataField",
            "encodings",
            "sampleRows"
          ],
          "properties": {
            "chartType": {
              "const": "bar"
            },
            "source": {
              "const": "record-array"
            },
            "dataField": {
              "type": "string",
              "minLength": 1,
              "description": "Declared objectSchema array field containing the chart rows."
            },
            "encodings": {
              "type": "object",
              "description": "Channel -> field bindings. Required, with at least x and y, when chartType is supplied (explicit mode).",
              "properties": {
                "x": {
                  "$ref": "#/$defs/chartEncodingBinding"
                },
                "y": {
                  "$ref": "#/$defs/chartEncodingBinding"
                },
                "color": {
                  "$ref": "#/$defs/chartColorEncodingBinding"
                },
                "size": {
                  "$ref": "#/$defs/chartEncodingBinding"
                },
                "shape": {
                  "$ref": "#/$defs/chartEncodingBinding"
                },
                "detail": {
                  "$ref": "#/$defs/chartEncodingBinding"
                }
              },
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ]
            },
            "sampleRows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": true
              },
              "description": "Authored sample rows, including explicitly labelled synthetic examples, copied into the declared array field of generated sample records. These exact records supply public viz.render; no separate synthetic chart series is invented."
            },
            "brand": {
              "enum": [
                "A",
                "B"
              ]
            }
          }
        }
      ]
    },
    "title": {
      "type": "string",
      "description": "Title of the read-only chart projection."
    },
    "description": {
      "type": "string",
      "description": "Accessible description of the read-only chart projection."
    }
  },
  "required": [
    "orientation"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "orientation": "vertical",
      "bandPadding": 0.2,
      "cornerRadius": 4,
      "stacking": "normalize"
    }
  ],
  "$defs": {
    "chartEncodingBinding": {
      "title": "ChartEncodingBinding",
      "description": "An encoding binding: either a bare field-name string, or an object with the field plus optional aggregate/scale/timeUnit/sort/title.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "aggregate": {
              "type": "string",
              "enum": [
                "sum",
                "count",
                "average",
                "median",
                "min",
                "max",
                "distinct"
              ]
            },
            "scale": {
              "type": "string",
              "enum": [
                "linear",
                "temporal",
                "log",
                "sqrt",
                "band",
                "point",
                "diverging"
              ]
            },
            "type": {
              "type": "string",
              "description": "Force the Vega-Lite/ECharts field type, overriding the engine's data-aware inference (sprint-125 m02 manual escape hatch). Wins over the m01 profile-derived type.",
              "enum": [
                "quantitative",
                "temporal",
                "ordinal",
                "nominal"
              ]
            },
            "timeUnit": {
              "type": "string",
              "enum": [
                "year",
                "quarter",
                "month",
                "week",
                "day",
                "hour",
                "minute",
                "second"
              ]
            },
            "sort": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "none",
                    "ascending",
                    "descending"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "field",
                    "order"
                  ],
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "order": {
                      "type": "string",
                      "enum": [
                        "ascending",
                        "descending"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "chartColorEncodingBinding": {
      "title": "ChartColorEncodingBinding",
      "description": "A color-channel encoding binding: like encodingBinding, plus an optional explicit `range` (hex colors) that overrides the baked OODS categorical palette on a nominal/ordinal color scale (sprint-147 F5). `range` is only valid on the color channel.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "aggregate": {
              "type": "string",
              "enum": [
                "sum",
                "count",
                "average",
                "median",
                "min",
                "max",
                "distinct"
              ]
            },
            "scale": {
              "type": "string",
              "enum": [
                "linear",
                "temporal",
                "log",
                "sqrt",
                "band",
                "point",
                "diverging"
              ]
            },
            "type": {
              "type": "string",
              "description": "Force the Vega-Lite/ECharts field type, overriding the engine's data-aware inference (sprint-125 m02 manual escape hatch). Wins over the m01 profile-derived type.",
              "enum": [
                "quantitative",
                "temporal",
                "ordinal",
                "nominal"
              ]
            },
            "timeUnit": {
              "type": "string",
              "enum": [
                "year",
                "quarter",
                "month",
                "week",
                "day",
                "hour",
                "minute",
                "second"
              ]
            },
            "sort": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "none",
                    "ascending",
                    "descending"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "field",
                    "order"
                  ],
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "order": {
                      "type": "string",
                      "enum": [
                        "ascending",
                        "descending"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "title": {
              "type": "string"
            },
            "range": {
              "type": "array",
              "description": "Explicit hex colors for a nominal/ordinal color scale (sprint-147 F5). Overrides the baked OODS categorical palette so an agent can supply its own scale (e.g. a 2-color presence scale). Applied in array order to the distinct series; a shorter range recycles (Vega domain[i]->range[i] mod len). Cartesian color only.",
              "items": {
                "type": "string",
                "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
              },
              "minItems": 2
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
