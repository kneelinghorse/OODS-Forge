{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oods.systems/schemas/traits/mark-area",
  "title": "MarkArea Trait Parameters",
  "type": "object",
  "properties": {
    "curve": {
      "type": "string",
      "description": "Curve interpolation strategy applied between samples.",
      "enum": [
        "linear",
        "monotone",
        "step"
      ],
      "default": "linear"
    },
    "opacity": {
      "type": "number",
      "description": "Fill opacity used for the area band.",
      "minimum": 0.2,
      "maximum": 1,
      "default": 0.65
    },
    "baseline": {
      "type": "string",
      "description": "Baseline reference for filling the region.",
      "enum": [
        "zero",
        "min"
      ],
      "default": "zero"
    },
    "tension": {
      "type": "number",
      "description": "Curve tension applied when smoothing.",
      "minimum": 0,
      "maximum": 1,
      "default": 0.3
    },
    "chart": {
      "description": "Read-only payment chart rendered by public viz.render during code generation. Workflow SVGs are static per seed record; consumers may replace the typed svg prop.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chartType",
        "source",
        "dateFields",
        "amountField",
        "minorUnits",
        "currencyField"
      ],
      "properties": {
        "chartType": {
          "const": "area"
        },
        "source": {
          "const": "payment-events"
        },
        "dateFields": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "amountField": {
          "type": "string",
          "minLength": 1
        },
        "minorUnits": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currencyField": {
          "type": "string",
          "minLength": 1
        },
        "brand": {
          "enum": [
            "A",
            "B"
          ]
        }
      }
    },
    "previewSvg": {
      "type": "string",
      "description": "Static SVG returned by viz.render for the authored sample."
    },
    "renderIntent": {
      "type": "string",
      "description": "JSON-encoded Cartesian viz.render input fragment for the governed authoring recipes. Data rows remain a consumer operand.",
      "default": "{}"
    }
  },
  "required": [],
  "additionalProperties": false,
  "examples": [
    {
      "curve": "monotone",
      "opacity": 0.7,
      "baseline": "zero",
      "tension": 0.25
    }
  ]
}
