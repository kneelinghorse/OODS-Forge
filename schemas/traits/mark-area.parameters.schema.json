{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oods.systems/schemas/traits/mark-area",
  "title": "MarkArea Trait Parameters",
  "type": "object",
  "properties": {
    "curve": {
      "type": "string",
      "description": "Curve interpolation strategy applied between samples.",
      "enum": [
        "linear",
        "monotone",
        "step"
      ],
      "default": "linear"
    },
    "opacity": {
      "type": "number",
      "description": "Fill opacity used for the area band.",
      "minimum": 0.2,
      "maximum": 1,
      "default": 0.65
    },
    "baseline": {
      "type": "string",
      "description": "Baseline reference for filling the region.",
      "enum": [
        "zero",
        "min"
      ],
      "default": "zero"
    },
    "tension": {
      "type": "number",
      "description": "Curve tension applied when smoothing.",
      "minimum": 0,
      "maximum": 1,
      "default": 0.3
    },
    "chart": {
      "title": "ChartDeclaration",
      "description": "Read-only chart rendered by public viz.render during code generation. Payment events retain the Subscription projection. Record-array charts bind a declared object array and use authored sampleRows to seed generated sample records, with no separate generated chart series. Static SVG assets are keyed by seed record identity; consumers can replace the typed svg prop. One distinct chart declaration is supported per generated object; repeated identical projections share the same asset.",
      "oneOf": [
        {
          "description": "Read-only payment chart rendered by public viz.render during code generation. Workflow SVGs are static per seed record; consumers may replace the typed svg prop.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chartType",
            "source",
            "dateFields",
            "amountField",
            "minorUnits",
            "currencyField"
          ],
          "properties": {
            "chartType": {
              "const": "area"
            },
            "source": {
              "const": "payment-events"
            },
            "dateFields": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "amountField": {
              "type": "string",
              "minLength": 1
            },
            "minorUnits": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currencyField": {
              "type": "string",
              "minLength": 1
            },
            "brand": {
              "enum": [
                "A",
                "B"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chartType",
            "source",
            "dataField",
            "encodings",
            "sampleRows"
          ],
          "properties": {
            "chartType": {
              "const": "area"
            },
            "source": {
              "const": "record-array"
            },
            "dataField": {
              "type": "string",
              "minLength": 1,
              "description": "Declared objectSchema array field containing the chart rows."
            },
            "encodings": {
              "type": "object",
              "description": "Channel -> field bindings. Required, with at least x and y, when chartType is supplied (explicit mode).",
              "properties": {
                "x": {
                  "$ref": "#/$defs/chartEncodingBinding"
                },
                "y": {
                  "$ref": "#/$defs/chartEncodingBinding"
                },
                "color": {
                  "$ref": "#/$defs/chartColorEncodingBinding"
                },
                "size": {
                  "$ref": "#/$defs/chartEncodingBinding"
                },
                "shape": {
                  "$ref": "#/$defs/chartEncodingBinding"
                },
                "detail": {
                  "$ref": "#/$defs/chartEncodingBinding"
                }
              },
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ]
            },
            "sampleRows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": true
              },
              "description": "Authored sample rows, including explicitly labelled synthetic examples, copied into the declared array field of generated sample records. These exact records supply public viz.render; no separate synthetic chart series is invented."
            },
            "brand": {
              "enum": [
                "A",
                "B"
              ]
            }
          }
        }
      ]
    },
    "previewSvg": {
      "type": "string",
      "description": "Static SVG returned by viz.render for the authored sample."
    },
    "renderIntent": {
      "type": "string",
      "description": "JSON-encoded Cartesian viz.render input fragment for the governed authoring recipes. Data rows remain a consumer operand.",
      "default": "{}"
    },
    "title": {
      "type": "string",
      "description": "Title of the read-only chart projection."
    },
    "description": {
      "type": "string",
      "description": "Accessible description of the read-only chart projection."
    }
  },
  "required": [],
  "additionalProperties": false,
  "examples": [
    {
      "curve": "monotone",
      "opacity": 0.7,
      "baseline": "zero",
      "tension": 0.25
    }
  ],
  "$defs": {
    "chartEncodingBinding": {
      "title": "ChartEncodingBinding",
      "description": "An encoding binding: either a bare field-name string, or an object with the field plus optional aggregate/scale/timeUnit/sort/title.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "aggregate": {
              "type": "string",
              "enum": [
                "sum",
                "count",
                "average",
                "median",
                "min",
                "max",
                "distinct"
              ]
            },
            "scale": {
              "type": "string",
              "enum": [
                "linear",
                "temporal",
                "log",
                "sqrt",
                "band",
                "point",
                "diverging"
              ]
            },
            "type": {
              "type": "string",
              "description": "Force the Vega-Lite/ECharts field type, overriding the engine's data-aware inference (sprint-125 m02 manual escape hatch). Wins over the m01 profile-derived type.",
              "enum": [
                "quantitative",
                "temporal",
                "ordinal",
                "nominal"
              ]
            },
            "timeUnit": {
              "type": "string",
              "enum": [
                "year",
                "quarter",
                "month",
                "week",
                "day",
                "hour",
                "minute",
                "second"
              ]
            },
            "sort": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "none",
                    "ascending",
                    "descending"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "field",
                    "order"
                  ],
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "order": {
                      "type": "string",
                      "enum": [
                        "ascending",
                        "descending"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "chartColorEncodingBinding": {
      "title": "ChartColorEncodingBinding",
      "description": "A color-channel encoding binding: like encodingBinding, plus an optional explicit `range` (hex colors) that overrides the baked OODS categorical palette on a nominal/ordinal color scale (sprint-147 F5). `range` is only valid on the color channel.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "aggregate": {
              "type": "string",
              "enum": [
                "sum",
                "count",
                "average",
                "median",
                "min",
                "max",
                "distinct"
              ]
            },
            "scale": {
              "type": "string",
              "enum": [
                "linear",
                "temporal",
                "log",
                "sqrt",
                "band",
                "point",
                "diverging"
              ]
            },
            "type": {
              "type": "string",
              "description": "Force the Vega-Lite/ECharts field type, overriding the engine's data-aware inference (sprint-125 m02 manual escape hatch). Wins over the m01 profile-derived type.",
              "enum": [
                "quantitative",
                "temporal",
                "ordinal",
                "nominal"
              ]
            },
            "timeUnit": {
              "type": "string",
              "enum": [
                "year",
                "quarter",
                "month",
                "week",
                "day",
                "hour",
                "minute",
                "second"
              ]
            },
            "sort": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "none",
                    "ascending",
                    "descending"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "field",
                    "order"
                  ],
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "order": {
                      "type": "string",
                      "enum": [
                        "ascending",
                        "descending"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "title": {
              "type": "string"
            },
            "range": {
              "type": "array",
              "description": "Explicit hex colors for a nominal/ordinal color scale (sprint-147 F5). Overrides the baked OODS categorical palette so an agent can supply its own scale (e.g. a 2-color presence scale). Applied in array order to the distinct series; a shorter range recycles (Vega domain[i]->range[i] mod len). Cartesian color only.",
              "items": {
                "type": "string",
                "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
              },
              "minItems": 2
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
