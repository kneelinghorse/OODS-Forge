# OODS Foundry MCP — local environment template
#
# Copy this file to `.env` and fill in real values. The repo `.gitignore`
# allowlists this file but blocks `.env` itself. All vitest runs, the MCP
# server (`packages/mcp-server/src/index.ts`), and the bridge
# (`packages/mcp-bridge/src/server.ts`) load `.env` automatically.

# ── Concordance integration ───────────────────────────────────────────────
# Bearer token for https://concordance-production.up.railway.app — never
# commit a real value. Required for RUN_HOSTED_SMOKE=1 live exercises.
CONCORDANCE_API_KEY=

# Override base URL (defaults to hosted Railway). Set to
# http://localhost:8787 to point at a local Concordance instance.
CONCORDANCE_BASE_URL=

# Per-call timeouts in ms. Defaults: blocking 5000, advisory 2000.
# I1 smoke spec raises blocking to 15000 for Railway cold starts.
CONCORDANCE_TIMEOUT_MS_BLOCKING=
CONCORDANCE_TIMEOUT_MS_ADVISORY=

# Multi-tenancy workspace identifier (optional; null by default).
CONCORDANCE_WORKSPACE=

# Test-only override for wire schema_version pin (warns when set).
CONCORDANCE_SCHEMA_VERSION_OVERRIDE=

# Set to "1" to skip the Concordance integration test suite.
CONCORDANCE_SKIP_INTEGRATION=

# ── Visual regression (Chromatic) ─────────────────────────────────────────
# Project token for chromatic publishes. CI's vr-test job skips cleanly
# when unset (continue-on-error + token guard, sprint-100 m01).
CHROMATIC_PROJECT_TOKEN=
